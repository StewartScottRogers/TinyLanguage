# Demo: mutually recursive functions
function isEvenNum(n : int) -> bool
    if n == 0 then
        return true
    end
    return isOddNum(n - 1)
end
function isOddNum(n : int) -> bool
    if n == 0 then
        return false
    end
    return isEvenNum(n - 1)
end
print isEvenNum(4)
print isOddNum(5)
print isEvenNum(7)