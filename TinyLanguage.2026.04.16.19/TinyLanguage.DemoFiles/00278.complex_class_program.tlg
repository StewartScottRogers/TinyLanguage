# Demo: complex class usage with methods and fields
class Stack {
    let Data : array := []
    let Size : int := 0
    Constructor()
    end
    function push(val)
        Data[Size] := val
        Size := Size + 1
    end
    function pop() -> int
        if Size == 0 then
            throw "Stack underflow"
        end
        Size := Size - 1
        return Data[Size]
    end
    function peek() -> int
        if Size == 0 then
            throw "Stack empty"
        end
        return Data[Size - 1]
    end
    function isEmpty() -> bool
        return Size == 0
    end
}
let s := new Stack()
s.push(1)
s.push(2)
s.push(3)
print s.peek()
print s.pop()
print s.pop()
print s.isEmpty()
print s.pop()
print s.isEmpty()