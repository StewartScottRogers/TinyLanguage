# Demo: passing lambda to function
function applyToArray(arr, transform)
    let result := []
    let i := 0
    foreach item in arr do
        result[i] := transform(item)
        i := i + 1
    end
    return result
end
let nums := [1, 2, 3, 4, 5]
let squared := applyToArray(nums, function(x : int) x * x)
foreach n in squared do
    print n
end