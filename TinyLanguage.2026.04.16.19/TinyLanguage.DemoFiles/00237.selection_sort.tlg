# Demo: selection sort algorithm
let arr := [64, 25, 12, 22, 11]
let n := len(arr)
for i := 0 to n - 2 do
    let minIdx := i
    for j := i + 1 to n - 1 do
        if arr[j] < arr[minIdx] then
            minIdx := j
        end
    end
    if minIdx != i then
        let temp := arr[i]
        arr[i] := arr[minIdx]
        arr[minIdx] := temp
    end
end
foreach val in arr do
    print val
end