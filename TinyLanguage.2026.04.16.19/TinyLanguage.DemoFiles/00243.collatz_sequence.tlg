# Demo: Collatz conjecture sequence
function collatz(n : int)
    let current := n
    let steps := 0
    while current != 1 do
        print current
        if current % 2 == 0 then
            current := current // 2
        else
            current := current * 3 + 1
        end
        steps := steps + 1
    end
    print 1
    print "Steps: " + str(steps)
end
collatz(6)