# Demo: multiple class instances
class Box {
    let Label : string := ""
    let Contents : int := 0
    Constructor(label : string, contents : int)
        Label := label
        Contents := contents
    end
    function describe() -> string
        return Label + ": " + str(Contents)
    end
}
let b1 := new Box("Box A", 10)
let b2 := new Box("Box B", 20)
let b3 := new Box("Box C", 30)
print b1.describe()
print b2.describe()
print b3.describe()