# Demo: is prime function
function isPrime(n : int) -> bool
    if n < 2 then
        return false
    end
    let i := 2
    while i * i <= n do
        if n % i == 0 then
            return false
        end
        i := i + 1
    end
    return true
end
for i := 1 to 30 do
    if isPrime(i) then
        print i
    end
end