# Demo: sum the digits of a number
function digitSumFn(n : int) -> int
    let sum := 0
    let remaining := n
    while remaining > 0 do
        sum := sum + remaining % 10
        remaining := remaining // 10
    end
    return sum
end
print digitSumFn(12345)
print digitSumFn(999)
print digitSumFn(100)