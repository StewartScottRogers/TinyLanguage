# Demo: 2x2 matrix multiplication
let a := [[1, 2], [3, 4]]
let b := [[5, 6], [7, 8]]
let c := [[0, 0], [0, 0]]
for i := 0 to 1 do
    for j := 0 to 1 do
        let sum := 0
        for k := 0 to 1 do
            sum := sum + a[i][k] * b[k][j]
        end
        c[i][j] := sum
    end
end
print c[0][0]
print c[0][1]
print c[1][0]
print c[1][1]