# Demo: join strings with separator
function join(arr, separator : string) -> string
    let result := ""
    let first := true
    foreach item in arr do
        if !first then
            result := result + separator
        end
        result := result + str(item)
        first := false
    end
    return result
end
let words := ["one", "two", "three"]
print join(words, ", ")
let nums := [1, 2, 3, 4, 5]
print join(nums, "-")