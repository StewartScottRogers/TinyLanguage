# Demo: map pattern with lambda
function mapArr(arr, transform)
    let result := []
    let i := 0
    foreach item in arr do
        result[i] := transform(item)
        i := i + 1
    end
    return result
end
let nums := [1, 2, 3, 4, 5]
let doubled := mapArr(nums, function(x : int) x * 2)
foreach n in doubled do
    print n
end