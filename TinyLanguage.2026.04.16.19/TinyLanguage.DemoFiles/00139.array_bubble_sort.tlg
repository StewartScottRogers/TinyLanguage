# Demo: bubble sort algorithm
let arr := [64, 34, 25, 12, 22, 11, 90]
let n := len(arr)
for i := 0 to n - 2 do
    for j := 0 to n - i - 2 do
        if arr[j] > arr[j + 1] then
            let temp := arr[j]
            arr[j] := arr[j + 1]
            arr[j + 1] := temp
        end
    end
end
foreach val in arr do
    print val
end