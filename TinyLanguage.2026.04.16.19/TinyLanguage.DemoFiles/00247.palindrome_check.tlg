# Demo: palindrome check
function isPalindrome(s : string) -> bool
    let n := len(s)
    let i := 0
    while i < n // 2 do
        if s[i] != s[n - i - 1] then
            return false
        end
        i := i + 1
    end
    return true
end
print isPalindrome("racecar")
print isPalindrome("hello")
print isPalindrome("aba")