# Demo: polymorphism via inheritance
class Shape {
    let Name : string := "shape"
    Constructor()
    end
    function area() -> float
        return 0.0
    end
    function describe() -> string
        return Name + " area=" + str(area())
    end
}
class Rect extends Shape {
    let W : float := 0.0
    let H : float := 0.0
    Constructor(w : float, h : float)
        Name := "rect"
        W := w
        H := h
    end
    function area() -> float
        return W * H
    end
}
let r := new Rect(4.0, 5.0)
print r.describe()