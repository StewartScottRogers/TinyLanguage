# Demo: count digits of a number
function countDigitsFn(n : int) -> int
    if n == 0 then
        return 1
    end
    let count := 0
    let remaining := n
    while remaining > 0 do
        count := count + 1
        remaining := remaining // 10
    end
    return count
end
print countDigitsFn(0)
print countDigitsFn(42)
print countDigitsFn(12345678)