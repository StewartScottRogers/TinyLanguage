# Demo: class with multiple methods
class Rectangle {
    let Width : int := 0
    let Height : int := 0
    Constructor(w : int, h : int)
        Width := w
        Height := h
    end
    function area() -> int
        return Width * Height
    end
    function perimeter() -> int
        return 2 * (Width + Height)
    end
}
let rect := new Rectangle(5, 3)
print rect.area()
print rect.perimeter()