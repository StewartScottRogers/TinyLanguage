# Demo: check if string contains substring
function contains(haystack : string, needle : string) -> bool
    let hl := len(haystack)
    let nl := len(needle)
    if nl > hl then
        return false
    end
    let i := 0
    while i <= hl - nl do
        let match := true
        let j := 0
        while j < nl do
            if haystack[i + j] != needle[j] then
                match := false
                break
            end
            j := j + 1
        end
        if match then
            return true
        end
        i := i + 1
    end
    return false
end
print contains("hello world", "world")
print contains("hello", "xyz")
print contains("abcdef", "cde")