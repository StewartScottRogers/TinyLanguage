# Demo: nested module calls
module StringUtils {
    function repeat(s : string, n : int) -> string
        let result := ""
        let i := 0
        while i < n do
            result := result + s
            i := i + 1
        end
        return result
    end
    function shout(s : string) -> string
        return s + "!"
    end
}
print StringUtils.repeat("ha", 3)
print StringUtils.shout("Hello")