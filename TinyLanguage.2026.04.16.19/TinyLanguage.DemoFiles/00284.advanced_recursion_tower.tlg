# Demo: Tower of Hanoi step counter
function hanoi(n : int, from : string, to : string, via : string) -> int
    if n == 0 then
        return 0
    end
    let moves := hanoi(n - 1, from, via, to) + 1 + hanoi(n - 1, via, to, from)
    return moves
end
for i := 1 to 8 do
    print "Hanoi(" + str(i) + ") = " + str(hanoi(i, "A", "C", "B"))
end