# Demo: data processing pipeline
let data := [15, 3, 9, 22, 7, 18, 1, 11, 6, 14]
# Find min, max, sum
let minVal := data[0]
let maxVal := data[0]
let total := 0
foreach n in data do
    if n < minVal then
        minVal := n
    end
    if n > maxVal then
        maxVal := n
    end
    total := total + n
end
print "Min: " + str(minVal)
print "Max: " + str(maxVal)
print "Sum: " + str(total)
print "Count: " + str(len(data))