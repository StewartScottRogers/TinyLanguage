# Demo: comprehensive array operations
let arr := [5, 3, 8, 1, 9, 2, 7, 4, 6]
print "Length: " + str(len(arr))
print "First: " + str(arr[0])
print "Last: " + str(arr[len(arr) - 1])
let sum := 0
foreach n in arr do
    sum := sum + n
end
print "Sum: " + str(sum)
arr[0] := 100
print "Modified first: " + str(arr[0])