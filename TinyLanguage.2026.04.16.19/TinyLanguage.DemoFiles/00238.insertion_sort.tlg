# Demo: insertion sort algorithm
let arr := [12, 11, 13, 5, 6]
let n := len(arr)
for i := 1 to n - 1 do
    let key := arr[i]
    let j := i - 1
    while j >= 0 and arr[j] > key do
        arr[j + 1] := arr[j]
        j := j - 1
    end
    arr[j + 1] := key
end
foreach val in arr do
    print val
end