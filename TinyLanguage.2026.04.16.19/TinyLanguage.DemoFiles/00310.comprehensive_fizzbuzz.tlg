# Demo: comprehensive FizzBuzz with analysis
let fizz_count := 0
let buzz_count := 0
let fizzbuzz_count := 0
let other_count := 0
for i := 1 to 100 do
    if i % 15 == 0 then
        fizzbuzz_count := fizzbuzz_count + 1
    else if i % 3 == 0 then
        fizz_count := fizz_count + 1
    else if i % 5 == 0 then
        buzz_count := buzz_count + 1
    else
        other_count := other_count + 1
    end
end
print "Fizz: " + str(fizz_count)
print "Buzz: " + str(buzz_count)
print "FizzBuzz: " + str(fizzbuzz_count)
print "Other: " + str(other_count)