# Demo: manual string ltrim
function ltrimFn(s : string) -> string
    let i := 0
    while i < len(s) and s[i] == " " do
        i := i + 1
    end
    let result := ""
    while i < len(s) do
        result := result + s[i]
        i := i + 1
    end
    return result
end
print ltrimFn("   hello")
print ltrimFn("world")
print ltrimFn("  spaces  ")