# Demo: comparing strings for sort order
let words := ["banana", "apple", "cherry", "date"]
let n := len(words)
let i := 0
while i < n - 1 do
    let j := 0
    while j < n - i - 1 do
        if words[j] > words[j + 1] then
            let temp := words[j]
            words[j] := words[j + 1]
            words[j + 1] := temp
        end
        j := j + 1
    end
    i := i + 1
end
foreach word in words do
    print word
end