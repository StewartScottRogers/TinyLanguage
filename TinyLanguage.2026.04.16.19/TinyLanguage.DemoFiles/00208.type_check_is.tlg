# Demo: is type check in expressions
let values := [42, "hello", true, 3.14]
foreach v in values do
    if v is int then
        print "int: " + str(v)
    else if v is string then
        print "string: " + str(v)
    else if v is bool then
        print "bool: " + str(v)
    else
        print "other: " + str(v)
    end
end