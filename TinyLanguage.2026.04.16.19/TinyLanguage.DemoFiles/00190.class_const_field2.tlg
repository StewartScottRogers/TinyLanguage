# Demo: const field in a class
class CircleConst {
    const PI : float := 3.14159265
    let Radius : float := 0.0
    Constructor(r : float)
        Radius := r
    end
    function area() -> float
        return PI * Radius * Radius
    end
    function circumference() -> float
        return 2.0 * PI * Radius
    end
}
let c := new CircleConst(5.0)
print c.area()
print c.circumference()