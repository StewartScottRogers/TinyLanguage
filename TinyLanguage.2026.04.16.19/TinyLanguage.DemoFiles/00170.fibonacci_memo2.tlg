# Demo: Fibonacci with memoization array cache
let fib_memo := [0, 1]
function fibWithMemo(n : int) -> int
    if n < len(fib_memo) then
        return fib_memo[n]
    end
    let result := fibWithMemo(n - 1) + fibWithMemo(n - 2)
    fib_memo[n] := result
    return result
end
for i := 0 to 15 do
    print fibWithMemo(i)
end