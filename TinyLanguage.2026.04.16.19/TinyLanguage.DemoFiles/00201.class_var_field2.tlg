# Demo: var field in class (requires type annotation)
class TempClass {
    var Celsius : float := 0.0
    Constructor(c : float)
        Celsius := c
    end
    function toFahrenheit() -> float
        return Celsius * 9.0 / 5.0 + 32.0
    end
}
let t := new TempClass(100.0)
print t.toFahrenheit()