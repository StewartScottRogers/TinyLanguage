# Demo: finally block for cleanup
function riskyOp(shouldFail : bool)
    let cleanup := "pending"
    try
        if shouldFail then
            throw "deliberate failure"
        end
        print "Success!"
    catch err
        print "Caught: " + str(err)
    finally
        cleanup := "done"
        print "Cleaned up: " + cleanup
    end
end
riskyOp(false)
riskyOp(true)