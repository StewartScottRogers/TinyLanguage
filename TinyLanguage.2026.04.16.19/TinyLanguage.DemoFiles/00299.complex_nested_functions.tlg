# Demo: complex nested function calls
function square(n : int) -> int
    return n * n
end
function sumOfSquares(a : int, b : int) -> int
    return square(a) + square(b)
end
function pythagorean(a : int, b : int, c : int) -> bool
    return sumOfSquares(a, b) == square(c)
end
print pythagorean(3, 4, 5)
print pythagorean(5, 12, 13)
print pythagorean(1, 2, 3)