# Demo: Caesar cipher ROT13 variant
let message := "HELLO WORLD"
let shifted := ""
foreach ch in message do
    if ch >= "A" and ch <= "Z" then
        let code := int(ch)
        let base := int("A")
        let shifted_code := (code - base + 13) % 26 + base
        shifted := shifted + str(shifted_code)
    else
        shifted := shifted + ch
    end
end
print shifted