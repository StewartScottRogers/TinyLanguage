# Demo: perfect number check up to 30
function isPerfect2(n : int) -> bool
    let sum := 0
    let i := 1
    while i < n do
        if n % i == 0 then
            sum := sum + i
        end
        i := i + 1
    end
    return sum == n
end
for i := 1 to 30 do
    if isPerfect2(i) then
        print i
    end
end