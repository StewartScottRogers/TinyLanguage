# Demo: generate array of range values
function makeRange2(start : int, stop : int, step : int)
    let result := []
    let i := start
    let idx := 0
    while i < stop do
        result[idx] := i
        idx := idx + 1
        i := i + step
    end
    return result
end
let evens := makeRange2(0, 10, 2)
foreach n in evens do
    print n
end