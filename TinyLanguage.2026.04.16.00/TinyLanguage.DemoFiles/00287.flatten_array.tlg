# Demo: flatten nested arrays one level deep
function flatten(nested)
    let result := []
    foreach subArr in nested do
        foreach item in subArr do
            result[len(result)] := item
        end
    end
    return result
end
let nested := [[1, 2, 3], [4, 5], [6, 7, 8, 9]]
let flat := flatten(nested)
foreach n in flat do
    print n
end
