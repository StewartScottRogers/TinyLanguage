# Demo: mutual recursion (even and odd)
function isEven(n : int) -> bool
    if n == 0 then
        return true
    end
    return isOdd(n - 1)
end
function isOdd(n : int) -> bool
    if n == 0 then
        return false
    end
    return isEven(n - 1)
end
print isEven(4)
print isOdd(7)
print isEven(9)
print isOdd(6)
