# Demo: error message formatting
function formatError(code : int, msg : string) -> string
    return "[ERROR " & str(code) & "] " & msg
end
function formatWarning(msg : string) -> string
    return "[WARN] " & msg
end
function formatInfo(msg : string) -> string
    return "[INFO] " & msg
end
print formatError(404, "Resource not found")
print formatError(500, "Internal server error")
print formatWarning("Deprecated function called")
print formatInfo("Application started")
