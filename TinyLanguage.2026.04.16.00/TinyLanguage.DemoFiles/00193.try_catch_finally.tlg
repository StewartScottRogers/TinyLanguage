# Demo: try/catch/finally block
let resourceOpen := false
resourceOpen := true
print "Resource opened"
try
    let x := 10
    let y := 0
    if y == 0 then
        throw "division by zero"
    end
    print x // y
catch e
    print "Caught: " & str(e)
finally
    resourceOpen := false
    print "Resource closed"
end
print resourceOpen
