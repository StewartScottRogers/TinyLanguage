# Demo: flatten one level of nested arrays
function flatten(matrix)
    let result := []
    let idx := 0
    foreach row in matrix do
        foreach item in row do
            result[idx] := item
            idx := idx + 1
        end
    end
    return result
end
let matrix := [[1, 2], [3, 4], [5, 6]]
let flat := flatten(matrix)
foreach item in flat do
    print item
end