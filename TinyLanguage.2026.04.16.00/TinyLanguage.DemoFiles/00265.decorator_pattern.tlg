# Demo: decorator pattern using higher-order functions
function logged(fn, name : string)
    return function(x)
        print "Calling " & name & "(" & str(x) & ")"
        let result := fn(x)
        print "Result: " & str(result)
        return result
    end
end
function timed(fn)
    return function(x)
        print "Before call"
        let result := fn(x)
        print "After call"
        return result
    end
end
let square := function(x : int) x * x
let loggedSquare := logged(square, "square")
loggedSquare(5)
let timedSquare := timed(square)
timedSquare(4)
