# Demo: currying pattern
function curry(fn)
    return function(a) function(b) fn(a, b)
end
function add(a : int, b : int) -> int
    return a + b
end
function multiply(a : int, b : int) -> int
    return a * b
end
let curriedAdd := curry(add)
let add5 := curriedAdd(5)
print add5(3)
print add5(10)
let curriedMul := curry(multiply)
let triple := curriedMul(3)
print triple(7)
print triple(4)
