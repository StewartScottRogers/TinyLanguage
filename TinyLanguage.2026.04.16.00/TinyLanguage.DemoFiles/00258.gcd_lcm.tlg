# Demo: GCD and LCM calculations
function gcd(a : int, b : int) -> int
    while b != 0 do
        let temp := b
        b := a % b
        a := temp
    end
    return a
end
function lcm(a : int, b : int) -> int
    return (a * b) // gcd(a, b)
end
print gcd(48, 18)
print gcd(100, 75)
print lcm(4, 6)
print lcm(12, 15)
let arr := [12, 18, 24]
let currentGcd := arr[0]
for i := 1 to len(arr) - 1 do
    currentGcd := gcd(currentGcd, arr[i])
end
print currentGcd
