# Demo: pattern matching with when guard conditions
function categorize(n : int) -> string
    match n {
        x when x < 0 => return "negative"
        0 => return "zero"
        x when x < 10 => return "small"
        x when x < 100 => return "medium"
        _ => return "large"
    }
end
print categorize(-5)
print categorize(0)
print categorize(7)
print categorize(42)
print categorize(500)
