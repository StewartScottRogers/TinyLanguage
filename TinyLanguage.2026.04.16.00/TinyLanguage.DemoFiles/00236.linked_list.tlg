# Demo: recursive linked list structure
class Node {
    let Value : int := 0
    let Next : Node := null
    Constructor(val : int)
        Value := val
        Next := null
    end
}
function prepend(head : Node, val : int) -> Node
    let newNode := new Node(val)
    newNode.Next := head
    return newNode
end
function printList(head : Node)
    let current := head
    while current != null do
        print current.Value
        current := current.Next
    end
end
function listLength(head : Node) -> int
    let count := 0
    let current := head
    while current != null do
        count := count + 1
        current := current.Next
    end
    return count
end
let head := new Node(1)
head := prepend(head, 2)
head := prepend(head, 3)
head := prepend(head, 4)
head := prepend(head, 5)
printList(head)
print listLength(head)
