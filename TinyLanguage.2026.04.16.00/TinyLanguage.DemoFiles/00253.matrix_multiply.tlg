# Demo: 2x2 matrix multiplication
function matMul2x2(a, b)
    let result := [[0, 0], [0, 0]]
    for i := 0 to 1 do
        for j := 0 to 1 do
            let sum := 0
            for k := 0 to 1 do
                sum := sum + a[i][k] * b[k][j]
            end
            let row := result[i]
            row[j] := sum
            result[i] := row
        end
    end
    return result
end
let A := [[1, 2], [3, 4]]
let B := [[5, 6], [7, 8]]
let C := matMul2x2(A, B)
print C[0][0]
print C[0][1]
print C[1][0]
print C[1][1]
