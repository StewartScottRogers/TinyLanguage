# Demo: Collatz conjecture sequence
function collatz(n : int) -> int
    let steps := 0
    let current := n
    while current != 1 do
        if current % 2 == 0 then
            current := current // 2
        else
            current := current * 3 + 1
        end
        steps := steps + 1
    end
    return steps
end
for i := 1 to 15 do
    print "collatz(" & str(i) & ") = " & str(collatz(i))
end
