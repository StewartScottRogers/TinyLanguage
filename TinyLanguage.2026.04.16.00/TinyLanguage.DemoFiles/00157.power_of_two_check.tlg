# Demo: check if number is power of 2
function isPowerOfTwo(n : int) -> bool
    if n <= 0 then
        return false
    end
    let remaining := n
    while remaining > 1 do
        if remaining % 2 != 0 then
            return false
        end
        remaining := remaining // 2
    end
    return true
end
print isPowerOfTwo(1)
print isPowerOfTwo(2)
print isPowerOfTwo(16)
print isPowerOfTwo(15)
print isPowerOfTwo(64)