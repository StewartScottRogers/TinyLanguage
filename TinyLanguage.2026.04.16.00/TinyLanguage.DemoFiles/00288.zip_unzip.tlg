# Demo: zip and unzip array operations
function zip(a, b)
    let result := []
    let n := len(a)
    if len(b) < n then
        n := len(b)
    end
    for i := 0 to n - 1 do
        result[i] := [a[i], b[i]]
    end
    return result
end
let keys := ["a", "b", "c"]
let vals := [1, 2, 3]
let zipped := zip(keys, vals)
foreach pair in zipped do
    print pair[0] & " -> " & str(pair[1])
end
