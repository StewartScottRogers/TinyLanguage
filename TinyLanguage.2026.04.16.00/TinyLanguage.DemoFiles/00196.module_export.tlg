# Demo: module with named exports
module GeomLib {
    function circleArea(r : float) -> float
        let pi := 3.14159
        return pi * r * r
    end
    function rectArea(w : float, h : float) -> float
        return w * h
    end
}
export GeomLib
let area1 := GeomLib.circleArea(5.0)
print area1
let area2 := GeomLib.rectArea(4.0, 6.0)
print area2
