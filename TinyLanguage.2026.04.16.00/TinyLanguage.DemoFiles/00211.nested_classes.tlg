# Demo: nested class hierarchy
class Address {
    let Street : string := ""
    let City : string := ""
    Constructor(street : string, city : string)
        Street := street
        City := city
    end
    function format() -> string
        return Street & ", " & City
    end
}
class Person {
    let Name : string := ""
    let Age : int := 0
    let Home : Address := null
    Constructor(name : string, age : int, home : Address)
        Name := name
        Age := age
        Home := home
    end
    function describe() -> string
        return Name & " (age " & str(Age) & ") lives at " & Home.format()
    end
}
let addr := new Address("123 Main St", "Springfield")
let person := new Person("Alice", 30, addr)
print person.describe()
