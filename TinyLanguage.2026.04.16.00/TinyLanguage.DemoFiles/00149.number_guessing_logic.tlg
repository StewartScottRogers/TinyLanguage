# Demo: number guessing game logic (no input)
let secret := 42
let guesses := [10, 50, 30, 42]
let found := false
foreach guess in guesses do
    if guess == secret then
        print "Found it: " + str(guess)
        found := true
    else if guess < secret then
        print str(guess) + " is too low"
    else
        print str(guess) + " is too high"
    end
end