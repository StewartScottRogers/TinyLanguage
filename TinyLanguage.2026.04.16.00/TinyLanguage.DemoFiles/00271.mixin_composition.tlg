# Demo: mixin-style composition via multiple methods
class Loggable {
    function log(msg : string)
        print "[LOG] " & msg
    end
    function warn(msg : string)
        print "[WARN] " & msg
    end
}
class Service extends Loggable {
    let Name : string := ""
    Constructor(name : string)
        Name := name
    end
    function start()
        log("Starting service: " & Name)
    end
    function stop()
        log("Stopping service: " & Name)
        warn("Service stopped: " & Name)
    end
}
let svc := new Service("MyService")
svc.start()
svc.stop()
