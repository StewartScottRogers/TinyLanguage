# Demo: string tokenization/split simulation
function splitBySpace(s : string)
    let words := []
    let current := ""
    foreach ch in s do
        if ch == " " then
            if len(current) > 0 then
                words[len(words)] := current
                current := ""
            end
        else
            current := current & ch
        end
    end
    if len(current) > 0 then
        words[len(words)] := current
    end
    return words
end
let sentence := "the quick brown fox"
let words := splitBySpace(sentence)
foreach w in words do
    print w
end
print len(words)
