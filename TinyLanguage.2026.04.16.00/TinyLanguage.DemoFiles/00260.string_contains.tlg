# Demo: string search and contains operations
function contains(haystack : string, needle : string) -> bool
    let hLen := len(haystack)
    let nLen := len(needle)
    if nLen > hLen then
        return false
    end
    for i := 0 to hLen - nLen do
        let isMatch := true
        for j := 0 to nLen - 1 do
            if haystack[i + j] != needle[j] then
                isMatch := false
            end
        end
        if isMatch then
            return true
        end
    end
    return false
end
print contains("hello world", "world")
print contains("hello world", "xyz")
print contains("abcdef", "cd")
print contains("abc", "abcd")
