# Demo: word counting in a string
function countWords(s : string) -> int
    let count := 0
    let inWord := false
    foreach ch in s do
        if ch == " " or ch == "\t" or ch == "\n" then
            inWord := false
        else
            if not inWord then
                count := count + 1
                inWord := true
            end
        end
    end
    return count
end
print countWords("hello world")
print countWords("the quick brown fox jumps")
print countWords("  spaces   around  ")
print countWords("")
