# Demo: iterator-like pattern using closures
function makeRangeIterator(start : int, stop : int)
    let current := start
    return function()
        if current >= stop then
            return -1
        end
        let val := current
        current := current + 1
        return val
    end
end
let iter := makeRangeIterator(1, 6)
let val := iter()
while val != -1 do
    print val
    val := iter()
end
