# Demo: convert integer to Roman numerals
function toRoman(n : int) -> string
    let values := [1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1]
    let symbols := ["M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"]
    let result := ""
    let num := n
    for i := 0 to len(values) - 1 do
        while num >= values[i] do
            result := result & symbols[i]
            num := num - values[i]
        end
    end
    return result
end
print toRoman(1)
print toRoman(4)
print toRoman(9)
print toRoman(40)
print toRoman(1994)
print toRoman(2024)
