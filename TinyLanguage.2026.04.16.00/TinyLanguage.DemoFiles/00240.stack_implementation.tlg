# Demo: stack data structure implementation
class Stack {
    let Data : array := []
    let Top : int := 0
    Constructor()
        Data := []
        Top := 0
    end
    function push(val)
        Data[Top] := val
        Top := Top + 1
    end
    function pop()
        if Top == 0 then
            throw "Stack underflow"
        end
        Top := Top - 1
        return Data[Top]
    end
    function peek()
        if Top == 0 then
            throw "Stack is empty"
        end
        return Data[Top - 1]
    end
    function isEmpty() -> bool
        return Top == 0
    end
    function size() -> int
        return Top
    end
}
let s := new Stack()
s.push(1)
s.push(2)
s.push(3)
print s.peek()
print s.pop()
print s.pop()
print s.size()
print s.isEmpty()
