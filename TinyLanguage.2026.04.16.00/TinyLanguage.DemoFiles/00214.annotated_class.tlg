# Demo: annotated class definition
@serializable
@version(major = 2)
class DataModel {
    let Id : int := 0
    let Label : string := ""
    Constructor(id : int, label : string)
        Id := id
        Label := label
    end
    function serialize() -> string
        return "{id:" & str(Id) & ",label:" & Label & "}"
    end
}
let dm := new DataModel(1, "test")
print dm.serialize()
