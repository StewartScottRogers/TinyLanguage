# Demo: BMI calculator
function bmi(weight : float, height : float) -> float
    return weight / (height * height)
end
function bmiCategory(bmiVal : float) -> string
    if bmiVal < 18.5 then
        return "Underweight"
    else
        if bmiVal < 25.0 then
            return "Normal"
        else
            if bmiVal < 30.0 then
                return "Overweight"
            else
                return "Obese"
            end
        end
    end
end
let bmiVal := bmi(70.0, 1.75)
print bmiVal
print bmiCategory(bmiVal)
