# Demo: Caesar cipher encryption/decryption
function charCode(ch : string) -> int
    let alphabet := "abcdefghijklmnopqrstuvwxyz"
    let i := 0
    foreach c in alphabet do
        if c == ch then
            return i
        end
        i := i + 1
    end
    return -1
end
function charAt(pos : int) -> string
    let alphabet := "abcdefghijklmnopqrstuvwxyz"
    return alphabet[pos]
end
function caesar(text : string, shift : int) -> string
    let result := ""
    foreach ch in text do
        let code := charCode(ch)
        if code == -1 then
            result := result & ch
        else
            let newCode := (code + shift) % 26
            result := result & charAt(newCode)
        end
    end
    return result
end
let msg := "hello world"
let encrypted := caesar(msg, 3)
print encrypted
let decrypted := caesar(encrypted, 23)
print decrypted
