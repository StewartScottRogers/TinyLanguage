# Demo: insertion sort
function insertionSort(arr)
    let n := len(arr)
    let i := 1
    while i < n do
        let key := arr[i]
        let j := i - 1
        while j >= 0 and arr[j] > key do
            arr[j + 1] := arr[j]
            j := j - 1
        end
        arr[j + 1] := key
        i := i + 1
    end
    return arr
end
let data := [12, 11, 13, 5, 6]
let sorted := insertionSort(data)
foreach item in sorted do
    print item
end