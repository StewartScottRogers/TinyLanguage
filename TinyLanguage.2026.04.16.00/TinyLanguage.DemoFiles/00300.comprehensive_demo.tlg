# Demo: comprehensive demo showcasing many language features together
const VERSION := "1.0"
enum Status { Active = 1, Inactive = 0, Pending = 2 }

class Item {
    let Name : string := ""
    let Price : float := 0.0
    let Active : int := 0
    Constructor(name : string, price : float, status : int)
        Name := name
        Price := price
        Active := status
    end
    function describe() -> string
        let statusStr := if Active == 1 then "active" else "inactive"
        return Name & " ($" & str(Price) & ") - " & statusStr
    end
}

function filterItems(items, pred)
    let result := []
    foreach item in items do
        if pred(item) then
            result[len(result)] := item
        end
    end
    return result
end

function totalPrice(items) -> float
    let total := 0.0
    foreach item in items do
        total := total + item.Price
    end
    return total
end

let inventory := [
    new Item("Apple", 0.99, Status.Active),
    new Item("Banana", 0.59, Status.Active),
    new Item("Cherry", 2.49, Status.Inactive),
    new Item("Date", 3.99, Status.Active)
]

print "TinyLanguage Store v" & VERSION
print "All items:"
foreach item in inventory do
    print item.describe()
end

let activeItems := filterItems(inventory, function(i : Item) i.Active == 1)
print "Active items: " & str(len(activeItems))
print "Total active price: $" & str(totalPrice(activeItems))

try
    foreach item in activeItems do
        if item.Price > 5.0 then
            throw "Price too high: " & item.Name
        end
    end
    print "All prices valid"
catch err
    print "Validation error: " & str(err)
end
