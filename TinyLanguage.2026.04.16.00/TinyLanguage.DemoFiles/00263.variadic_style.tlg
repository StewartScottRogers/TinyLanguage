# Demo: variadic-style function using array argument
function sum(numbers)
    let total := 0
    foreach n in numbers do
        total := total + n
    end
    return total
end
function max(numbers)
    let best := numbers[0]
    foreach n in numbers do
        if n > best then
            best := n
        end
    end
    return best
end
print sum([1, 2, 3, 4, 5])
print sum([10, 20, 30])
print max([3, 1, 4, 1, 5, 9, 2, 6])
