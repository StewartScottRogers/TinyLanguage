# Demo: quicksort algorithm
function quickSort(arr, low : int, high : int)
    if low < high then
        let pivot := arr[high]
        let i := low - 1
        for j := low to high - 1 do
            if arr[j] <= pivot then
                i := i + 1
                let temp := arr[i]
                arr[i] := arr[j]
                arr[j] := temp
            end
        end
        let temp2 := arr[i + 1]
        arr[i + 1] := arr[high]
        arr[high] := temp2
        let pi := i + 1
        quickSort(arr, low, pi - 1)
        quickSort(arr, pi + 1, high)
    end
end
let arr := [10, 7, 8, 9, 1, 5]
quickSort(arr, 0, len(arr) - 1)
foreach n in arr do
    print n
end
