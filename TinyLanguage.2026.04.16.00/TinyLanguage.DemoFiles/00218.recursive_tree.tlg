# Demo: recursive tree data structure
class TreeNode {
    let Value : int := 0
    let Left : TreeNode := null
    let Right : TreeNode := null
    Constructor(val : int)
        Value := val
        Left := null
        Right := null
    end
}
function insert(node : TreeNode, val : int) -> TreeNode
    if node == null then
        return new TreeNode(val)
    end
    if val < node.Value then
        node.Left := insert(node.Left, val)
    else
        node.Right := insert(node.Right, val)
    end
    return node
end
function inorder(node : TreeNode)
    if node == null then
        return
    end
    inorder(node.Left)
    print node.Value
    inorder(node.Right)
end
let root := new TreeNode(5)
insert(root, 3)
insert(root, 7)
insert(root, 1)
insert(root, 4)
inorder(root)
