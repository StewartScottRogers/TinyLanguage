# Demo: FizzBuzz using functional decomposition
function fizzBuzzResult(n : int) -> string
    let divBy3 := n % 3 == 0
    let divBy5 := n % 5 == 0
    if divBy3 and divBy5 then
        return "FizzBuzz"
    end
    if divBy3 then
        return "Fizz"
    end
    if divBy5 then
        return "Buzz"
    end
    return str(n)
end
for i := 1 to 20 do
    print fizzBuzzResult(i)
end
