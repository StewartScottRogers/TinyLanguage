# Demo: matrix transposition
function transpose(matrix)
    let rows := len(matrix)
    let cols := len(matrix[0])
    let result := []
    for j := 0 to cols - 1 do
        let newRow := []
        for i := 0 to rows - 1 do
            newRow[i] := matrix[i][j]
        end
        result[j] := newRow
    end
    return result
end
let m := [[1, 2, 3], [4, 5, 6]]
let t := transpose(m)
for i := 0 to len(t) - 1 do
    let row := t[i]
    let line := ""
    for j := 0 to len(row) - 1 do
        line := line & str(row[j]) & " "
    end
    print line
end
