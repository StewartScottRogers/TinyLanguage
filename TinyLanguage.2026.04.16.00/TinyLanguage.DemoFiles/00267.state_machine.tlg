# Demo: simple state machine
class StateMachine {
    let State : string := ""
    Constructor(initial : string)
        State := initial
    end
    function transition(event : string)
        match State {
            "idle" => 
                if event == "start" then
                    State := "running"
                    print "Started"
                end
            "running" =>
                if event == "pause" then
                    State := "paused"
                    print "Paused"
                end
                if event == "stop" then
                    State := "idle"
                    print "Stopped"
                end
            "paused" =>
                if event == "resume" then
                    State := "running"
                    print "Resumed"
                end
                if event == "stop" then
                    State := "idle"
                    print "Stopped from pause"
                end
            _ => print "Unknown state"
        }
    end
    function getState() -> string
        return State
    end
}
let sm := new StateMachine("idle")
print sm.getState()
sm.transition("start")
sm.transition("pause")
sm.transition("resume")
sm.transition("stop")
print sm.getState()
