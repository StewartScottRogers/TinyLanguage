# Demo: Sieve of Eratosthenes for prime numbers
function sieve(limit : int)
    let isPrime := []
    for i := 0 to limit do
        isPrime[i] := true
    end
    isPrime[0] := false
    isPrime[1] := false
    for p := 2 to limit do
        if isPrime[p] then
            let mult := p * p
            while mult <= limit do
                isPrime[mult] := false
                mult := mult + p
            end
        end
    end
    let primes := []
    for i := 2 to limit do
        if isPrime[i] then
            primes[len(primes)] := i
        end
    end
    return primes
end
let primes := sieve(50)
foreach p in primes do
    print p
end
