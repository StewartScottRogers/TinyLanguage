# Demo: bubble sort algorithm
function bubbleSort(arr)
    let n := len(arr)
    let i := 0
    while i < n do
        let j := 0
        while j < n - i - 1 do
            if arr[j] > arr[j + 1] then
                let temp := arr[j]
                arr[j] := arr[j + 1]
                arr[j + 1] := temp
            end
            j := j + 1
        end
        i := i + 1
    end
    return arr
end
let data := [64, 34, 25, 12, 22, 11, 90]
let sorted := bubbleSort(data)
foreach item in sorted do
    print item
end