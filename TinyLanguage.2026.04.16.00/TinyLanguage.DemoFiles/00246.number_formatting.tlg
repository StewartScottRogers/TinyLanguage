# Demo: number formatting and conversion utilities
function intToHex(n : int) -> string
    if n == 0 then
        return "0"
    end
    let digits := "0123456789ABCDEF"
    let result := ""
    let num := n
    while num > 0 do
        let rem := num % 16
        result := digits[rem] & result
        num := num // 16
    end
    return "0x" & result
end
print intToHex(255)
print intToHex(16)
print intToHex(256)
print intToHex(0)
