# Demo: bool arithmetic and short-circuit evaluation
function sideEffect(name : string, val : bool) -> bool
    print "Evaluated: " & name
    return val
end
let a := true
let b := false
print a && b
print a || b
print not a
if sideEffect("left", false) && sideEffect("right", true) then
    print "both true"
else
    print "short-circuited"
end
if sideEffect("left2", true) || sideEffect("right2", false) then
    print "short-circuited or"
end
