# Demo: map operation using lambda
function map(arr, fn)
    let result := []
    foreach item in arr do
        result[len(result)] := fn(item)
    end
    return result
end
let nums := [1, 2, 3, 4, 5]
let squares := map(nums, function(x : int) x * x)
foreach s in squares do
    print s
end
let strs := map(nums, function(x : int) str(x) & "!")
foreach s in strs do
    print s
end
