# Demo: computing power set of small array
function powerSet(arr)
    let result := [[]]
    foreach item in arr do
        let newSets := []
        foreach existing in result do
            let newSet := []
            foreach elem in existing do
                newSet[len(newSet)] := elem
            end
            newSet[len(newSet)] := item
            newSets[len(newSets)] := newSet
        end
        foreach ns in newSets do
            result[len(result)] := ns
        end
    end
    return result
end
let sets := powerSet([1, 2, 3])
print len(sets)
