# Demo: class with methods that call other methods
class Calculator {
    let Value : int := 0
    Constructor(initial : int)
        Value := initial
    end
    function add(n : int) -> int
        Value := Value + n
        return Value
    end
    function multiply(n : int) -> int
        Value := Value * n
        return Value
    end
    function getResult() -> int
        return Value
    end
    function addThenMultiply(addVal : int, mulVal : int) -> int
        add(addVal)
        return multiply(mulVal)
    end
}
let calc := new Calculator(5)
print calc.add(3)
print calc.multiply(2)
print calc.addThenMultiply(4, 3)
