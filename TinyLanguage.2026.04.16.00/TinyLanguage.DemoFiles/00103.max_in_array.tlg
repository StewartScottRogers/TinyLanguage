# Demo: find maximum value in array
function maxInArray(arr) -> int
    let maxVal := arr[0]
    let i := 1
    while i < len(arr) do
        if arr[i] > maxVal then
            maxVal := arr[i]
        end
        i := i + 1
    end
    return maxVal
end
let nums := [3, 1, 4, 1, 5, 9, 2, 6, 5, 3]
print maxInArray(nums)