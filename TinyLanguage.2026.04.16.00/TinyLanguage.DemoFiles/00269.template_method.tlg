# Demo: template method pattern
class DataProcessor {
    function process(data)
        let cleaned := clean(data)
        let validated := validate(cleaned)
        let result := transform(validated)
        return result
    end
    function clean(data) -> string
        return data
    end
    function validate(data) -> string
        return data
    end
    function transform(data) -> string
        return data
    end
}
class UpperProcessor extends DataProcessor {
    function clean(data) -> string
        return data
    end
    function validate(data) -> string
        print "Validating: " & data
        return data
    end
    function transform(data) -> string
        let result := ""
        foreach ch in data do
            result := result & ch
        end
        return "PROCESSED: " & result
    end
}
let proc := new UpperProcessor()
print proc.process("hello world")
