# Demo: zip two arrays together (pair-wise sum)
function zipSum(a, b)
    let result := []
    let n := len(a)
    let i := 0
    while i < n do
        result[i] := a[i] + b[i]
        i := i + 1
    end
    return result
end
let xs := [1, 2, 3, 4, 5]
let ys := [10, 20, 30, 40, 50]
let zipped := zipSum(xs, ys)
foreach item in zipped do
    print item
end