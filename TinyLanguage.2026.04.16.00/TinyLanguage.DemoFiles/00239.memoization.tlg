# Demo: memoization pattern for expensive computations
let cache := []
for i := 0 to 99 do
    cache[i] := -1
end
function fib(n : int) -> int
    if n <= 1 then
        return n
    end
    if cache[n] != -1 then
        return cache[n]
    end
    let result := fib(n - 1) + fib(n - 2)
    cache[n] := result
    return result
end
for i := 0 to 10 do
    print fib(i)
end
