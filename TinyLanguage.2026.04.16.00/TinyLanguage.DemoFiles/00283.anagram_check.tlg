# Demo: anagram detection
function charFreq(s : string)
    let freq := []
    for i := 0 to 25 do
        freq[i] := 0
    end
    let a := "a"
    foreach ch in s do
        let code := 0
        let alphabet := "abcdefghijklmnopqrstuvwxyz"
        let i := 0
        foreach ac in alphabet do
            if ac == ch then
                code := i
            end
            i := i + 1
        end
        freq[code] := freq[code] + 1
    end
    return freq
end
function isAnagram(s1 : string, s2 : string) -> bool
    if len(s1) != len(s2) then
        return false
    end
    let f1 := charFreq(s1)
    let f2 := charFreq(s2)
    for i := 0 to 25 do
        if f1[i] != f2[i] then
            return false
        end
    end
    return true
end
print isAnagram("listen", "silent")
print isAnagram("hello", "world")
print isAnagram("anagram", "nagaram")
