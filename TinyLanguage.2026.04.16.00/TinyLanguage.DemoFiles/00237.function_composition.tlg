# Demo: function composition with higher-order functions
function compose(f, g)
    return function(x) f(g(x))
end
function pipe(f, g)
    return function(x) g(f(x))
end
let double := function(x : int) x * 2
let addThree := function(x : int) x + 3
let doubleFirst := compose(double, addThree)
let addFirst := pipe(double, addThree)
print doubleFirst(5)
print addFirst(5)
