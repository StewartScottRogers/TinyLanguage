# Demo: recursion with accumulator (tail-call style)
function factAcc(n : int, acc : int) -> int
    if n <= 0 then
        return acc
    end
    return factAcc(n - 1, acc * n)
end
function factorial(n : int) -> int
    return factAcc(n, 1)
end
function sumAcc(n : int, acc : int) -> int
    if n <= 0 then
        return acc
    end
    return sumAcc(n - 1, acc + n)
end
print factorial(10)
print sumAcc(100, 0)
