# Demo: Fibonacci - iterative implementation
function fibIter(n : int) -> int
    if n <= 1 then
        return n
    end
    let a := 0
    let b := 1
    let count := 2
    while count <= n do
        let temp := a + b
        a := b
        b := temp
        count := count + 1
    end
    return b
end
for i := 0 to 15 do
    print fibIter(i)
end