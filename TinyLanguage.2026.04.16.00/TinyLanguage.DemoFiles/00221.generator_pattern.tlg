# Demo: generator-like pattern using accumulated results
function range(start : int, stop : int, step : int)
    let result := []
    let i := start
    while i < stop do
        result[len(result)] := i
        i := i + step
    end
    return result
end
let evens := range(0, 10, 2)
foreach e in evens do
    print e
end
let fives := range(0, 50, 5)
foreach f in fives do
    print f
end
