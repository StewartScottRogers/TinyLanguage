# Demo: deeper class inheritance hierarchy
class Vehicle {
    let Brand : string := ""
    Constructor(brand : string)
        Brand := brand
    end
    function describe() -> string
        return "Vehicle: " & Brand
    end
}
class Car extends Vehicle {
    let Model : string := ""
    Constructor(brand : string, model : string)
        Brand := brand
        Model := model
    end
    function describe() -> string
        return "Car: " & Brand & " " & Model
    end
}
class ElectricCar extends Car {
    let Range : int := 0
    Constructor(brand : string, model : string, range : int)
        Brand := brand
        Model := model
        Range := range
    end
    function describe() -> string
        return "Electric: " & Brand & " " & Model & " (" & str(Range) & "mi)"
    end
}
let car := new Car("Toyota", "Camry")
print car.describe()
let ev := new ElectricCar("Tesla", "Model 3", 350)
print ev.describe()
