# Demo: string operations (len, concatenation, indexing)
let s := "Hello, World!"
print len(s)
let greeting := "Hello" & ", " & "TinyLanguage!"
print greeting
let first := s[0]
print first
let sub := s[0] & s[1] & s[2] & s[3] & s[4]
print sub
let combined := str(42) & " is the answer"
print combined
