# Demo: class with annotated fields
class Config {
    @required
    let Name : string := ""
    @defaultValue(value = 80)
    let Port : int := 80
    @optional
    let Host : string := "localhost"
    Constructor(name : string, port : int, host : string)
        Name := name
        Port := port
        Host := host
    end
    function display() -> string
        return Name & " on " & Host & ":" & str(Port)
    end
}
let cfg := new Config("MyApp", 8080, "0.0.0.0")
print cfg.display()
