# Demo: graph represented as adjacency list using arrays
function addEdge(graph, from : int, to : int)
    let row := graph[from]
    row[len(row)] := to
    graph[from] := row
end
let graph := [[], [], [], [], []]
addEdge(graph, 0, 1)
addEdge(graph, 0, 2)
addEdge(graph, 1, 3)
addEdge(graph, 2, 4)
foreach neighbor in graph[0] do
    print "0 -> " & str(neighbor)
end
foreach neighbor in graph[1] do
    print "1 -> " & str(neighbor)
end
