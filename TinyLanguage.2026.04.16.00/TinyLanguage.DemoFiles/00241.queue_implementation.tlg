# Demo: queue data structure implementation
class Queue {
    let Data : array := []
    let Head : int := 0
    let Tail : int := 0
    Constructor()
        Data := []
        Head := 0
        Tail := 0
    end
    function enqueue(val)
        Data[Tail] := val
        Tail := Tail + 1
    end
    function dequeue()
        if Head == Tail then
            throw "Queue is empty"
        end
        let val := Data[Head]
        Head := Head + 1
        return val
    end
    function isEmpty() -> bool
        return Head == Tail
    end
    function size() -> int
        return Tail - Head
    end
}
let q := new Queue()
q.enqueue("first")
q.enqueue("second")
q.enqueue("third")
print q.size()
print q.dequeue()
print q.dequeue()
print q.isEmpty()
