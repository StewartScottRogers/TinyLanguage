# Demo: class with multiple methods
class Counter {
    let Count : int := 0
    Constructor(start : int)
        Count := start
    end
    function increment()
        Count := Count + 1
    end
    function decrement()
        Count := Count - 1
    end
    function getValue() -> int
        return Count
    end
}
let c := new Counter(10)
c.increment()
c.increment()
c.increment()
print c.getValue()
c.decrement()
print c.getValue()