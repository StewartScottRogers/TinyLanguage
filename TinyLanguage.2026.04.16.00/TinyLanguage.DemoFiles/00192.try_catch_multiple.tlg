# Demo: try/catch with typed exception handling
function riskyDiv(a : int, b : int) -> int
    if b == 0 then
        throw "DivisionByZero"
    end
    return a // b
end
try
    print riskyDiv(10, 2)
    print riskyDiv(7, 0)
catch err
    match str(err) {
        "DivisionByZero" => print "Cannot divide by zero"
        _ => print "Unknown error: " & str(err)
    }
end
