# Demo: count vowels in a string
function isVowel(ch : string) -> bool
    return ch == "a" or ch == "e" or ch == "i" or ch == "o" or ch == "u"
end
function countVowels(s : string) -> int
    let count := 0
    foreach ch in s do
        if isVowel(ch) then
            count := count + 1
        end
    end
    return count
end
print countVowels("Hello World")
print countVowels("aeiou")
print countVowels("rhythm")