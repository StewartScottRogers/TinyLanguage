# Demo: strategy pattern with lambda strategies
function sortWith(arr, compareFn)
    let n := len(arr)
    for i := 0 to n - 2 do
        for j := 0 to n - i - 2 do
            if compareFn(arr[j], arr[j + 1]) > 0 then
                let tmp := arr[j]
                arr[j] := arr[j + 1]
                arr[j + 1] := tmp
            end
        end
    end
    return arr
end
let ascending := function(a : int, b : int) a - b
let descending := function(a : int, b : int) b - a
let nums := [3, 1, 4, 1, 5, 9, 2, 6]
let asc := sortWith([3, 1, 4, 1, 5, 9, 2, 6], ascending)
foreach n in asc do
    print n
end
let desc := sortWith([3, 1, 4, 1, 5, 9, 2, 6], descending)
foreach n in desc do
    print n
end
