# Demo: using a class as an exception object
class AppError {
    let Code : int := 0
    let Message : string := ""
    Constructor(code : int, msg : string)
        Code := code
        Message := msg
    end
    function format() -> string
        return "Error " & str(Code) & ": " & Message
    end
}
function validate(n : int)
    if n < 0 then
        throw new AppError(400, "Value must be non-negative")
    end
    if n > 1000 then
        throw new AppError(413, "Value too large")
    end
    print "Valid: " & str(n)
end
try
    validate(42)
    validate(-1)
catch e
    if e is AppError then
        let err := e as AppError
        print err.format()
    else
        print "Unknown error: " & str(e)
    end
end
