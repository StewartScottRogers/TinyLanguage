# Demo: count words in a string (split by spaces)
function countWords(s : string) -> int
    let count := 0
    let inWord := false
    foreach ch in s do
        if ch == " " then
            inWord := false
        else
            if !inWord then
                count := count + 1
                inWord := true
            end
        end
    end
    return count
end
print countWords("Hello World")
print countWords("The quick brown fox")
print countWords("one")
print countWords("")