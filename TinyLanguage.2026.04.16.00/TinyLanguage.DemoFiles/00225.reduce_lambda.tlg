# Demo: reduce/fold operation using lambda
function reduce(arr, fn, initial)
    let acc := initial
    foreach item in arr do
        acc := fn(acc, item)
    end
    return acc
end
let nums := [1, 2, 3, 4, 5]
let sum := reduce(nums, function(a : int, b : int) a + b, 0)
print sum
let product := reduce(nums, function(a : int, b : int) a * b, 1)
print product
let maxVal := reduce(nums, function(a : int, b : int) if a > b then a else b, 0)
print maxVal
