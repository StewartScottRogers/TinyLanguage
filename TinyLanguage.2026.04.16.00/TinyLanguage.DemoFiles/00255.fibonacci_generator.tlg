# Demo: Fibonacci sequence generator pattern
function makeFibGenerator()
    let a := 0
    let b := 1
    return function()
        let result := a
        let newB := a + b
        a := b
        b := newB
        return result
    end
end
let fib := makeFibGenerator()
for i := 1 to 15 do
    print fib()
end
