# Demo: linear search algorithm
function linearSearch(arr, target : int) -> int
    let i := 0
    while i < len(arr) do
        if arr[i] == target then
            return i
        end
        i := i + 1
    end
    return -1
end
let data := [5, 3, 7, 1, 9, 2, 8]
print linearSearch(data, 9)
print linearSearch(data, 6)
print linearSearch(data, 5)