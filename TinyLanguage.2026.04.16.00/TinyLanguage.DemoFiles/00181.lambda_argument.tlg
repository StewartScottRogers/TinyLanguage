# Demo: lambda passed as argument to a higher-order function
function transform(arr, fn) -> array
    let result := []
    foreach item in arr do
        result[len(result)] := fn(item)
    end
    return result
end
let nums := [1, 2, 3, 4, 5]
let doubled := transform(nums, function(x : int) x * 2)
foreach n in doubled do
    print n
end
