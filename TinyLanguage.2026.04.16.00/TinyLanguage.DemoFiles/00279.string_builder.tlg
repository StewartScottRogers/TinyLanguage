# Demo: string builder accumulation pattern
class StrBuilder {
    let Parts : array := []
    Constructor()
        Parts := []
    end
    function append(s : string) -> StrBuilder
        Parts[len(Parts)] := s
        return this
    end
    function build() -> string
        let result := ""
        foreach part in Parts do
            result := result & part
        end
        return result
    end
}
let sb := new StrBuilder()
sb.append("Hello")
sb.append(", ")
sb.append("World")
sb.append("!")
print sb.build()
