# Demo: merge sort algorithm
function merge(left, right)
    let result := []
    let i := 0
    let j := 0
    while i < len(left) and j < len(right) do
        if left[i] <= right[j] then
            result[len(result)] := left[i]
            i := i + 1
        else
            result[len(result)] := right[j]
            j := j + 1
        end
    end
    while i < len(left) do
        result[len(result)] := left[i]
        i := i + 1
    end
    while j < len(right) do
        result[len(result)] := right[j]
        j := j + 1
    end
    return result
end
function mergeSort(arr)
    let n := len(arr)
    if n <= 1 then
        return arr
    end
    let mid := n // 2
    let left := []
    let right := []
    for i := 0 to mid - 1 do
        left[i] := arr[i]
    end
    for i := mid to n - 1 do
        right[i - mid] := arr[i]
    end
    return merge(mergeSort(left), mergeSort(right))
end
let arr := [38, 27, 43, 3, 9, 82, 10]
let sorted := mergeSort(arr)
foreach n in sorted do
    print n
end
