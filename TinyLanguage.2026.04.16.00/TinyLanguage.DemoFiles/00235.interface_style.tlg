# Demo: class implementing interface-like contract
class Printable {
    function toString() -> string
        return "Printable"
    end
}
class Circle extends Printable {
    let Radius : float := 0.0
    Constructor(r : float)
        Radius := r
    end
    function toString() -> string
        return "Circle(r=" & str(Radius) & ")"
    end
    function area() -> float
        return 3.14159 * Radius * Radius
    end
}
class Square extends Printable {
    let Side : float := 0.0
    Constructor(s : float)
        Side := s
    end
    function toString() -> string
        return "Square(s=" & str(Side) & ")"
    end
    function area() -> float
        return Side * Side
    end
}
let c := new Circle(5.0)
print c.toString()
print c.area()
let sq := new Square(4.0)
print sq.toString()
print sq.area()
