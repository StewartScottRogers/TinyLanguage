# Demo: bitwise-style operations using integer arithmetic
function bitwiseAnd(a : int, b : int) -> int
    let result := 0
    let bit := 1
    for i := 0 to 30 do
        if (a % (bit * 2) >= bit) and (b % (bit * 2) >= bit) then
            result := result + bit
        end
        bit := bit * 2
    end
    return result
end
function bitwiseOr(a : int, b : int) -> int
    let result := 0
    let bit := 1
    for i := 0 to 30 do
        if (a % (bit * 2) >= bit) or (b % (bit * 2) >= bit) then
            result := result + bit
        end
        bit := bit * 2
    end
    return result
end
print bitwiseAnd(12, 10)
print bitwiseOr(12, 10)
