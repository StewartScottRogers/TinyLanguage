class Inner {
  let value := 0
  Constructor(v)
    this.value := v
  end
  function doubled()
    return this.value * 2
  end
}
class Outer {
  let inner := null
  Constructor(v)
    this.inner := new Inner(v)
  end
  function innerDoubled()
    return this.inner.doubled()
  end
}
let o := new Outer(21)
print o.innerDoubled()
print o.inner.value
