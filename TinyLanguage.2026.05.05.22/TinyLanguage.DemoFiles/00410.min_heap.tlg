# Data structure: min-heap (array-based binary heap)
# Subroutines: Insert, ExtractMin, Peek, HeapifyUp, HeapifyDown, Size
# Workload: insert 10 values in scrambled order, extract-min 5 times, verify ascending order

class MinHeap {
  let data := []
  let size := 0

  function Insert(x)
    this.data[this.size] := x
    this.size := this.size + 1
    this.HeapifyUp(this.size - 1)
  end

  function HeapifyUp(i)
    while i > 0 do
      let parent := (i - 1) // 2
      if this.data[i] < this.data[parent] then
        let tmp := this.data[i]
        this.data[i] := this.data[parent]
        this.data[parent] := tmp
        i := parent
      else
        return
      end
    end
  end

  function ExtractMin()
    if this.size == 0 then throw "heap empty" end
    let min := this.data[0]
    this.size := this.size - 1
    this.data[0] := this.data[this.size]
    this.HeapifyDown(0)
    return min
  end

  function HeapifyDown(i)
    while true do
      let left := 2 * i + 1
      let right := 2 * i + 2
      let smallest := i
      if left < this.size and this.data[left] < this.data[smallest] then
        smallest := left
      end
      if right < this.size and this.data[right] < this.data[smallest] then
        smallest := right
      end
      if smallest == i then return end
      let tmp := this.data[i]
      this.data[i] := this.data[smallest]
      this.data[smallest] := tmp
      i := smallest
    end
  end

  function Peek()
    if this.size == 0 then return null end
    return this.data[0]
  end

  function Size()
    return this.size
  end
}

let heap := new MinHeap()
let vals := [9, 4, 7, 1, 5, 3, 8, 2, 6, 10]
foreach v in vals do
  heap.Insert(v)
end
print "Size: " & str(heap.Size())
print "Peek (min): " & str(heap.Peek())
print "Extract-min 5 times (should be 1,2,3,4,5):"
for i := 1 to 5 do
  print heap.ExtractMin()
end
print "Remaining size: " & str(heap.Size())
print "New min: " & str(heap.Peek())
