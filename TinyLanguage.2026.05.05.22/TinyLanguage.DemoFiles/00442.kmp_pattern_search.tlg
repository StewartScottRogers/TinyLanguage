# Data structure: failure function table for KMP string matching
# Subroutines: BuildFailure, KMPSearch, FindAll, MatchCount
# Workload: search for pattern in 3 different texts, verify match positions

function BuildFailure(pattern)
  let m := len(pattern)
  let fail := []
  fail[0] := 0
  let k := 0
  for i := 1 to m - 1 do
    while k > 0 and pattern[k] != pattern[i] do
      k := fail[k - 1]
    end
    if pattern[k] == pattern[i] then
      k := k + 1
    end
    fail[i] := k
  end
  return fail
end

function KMPSearch(text, pattern)
  let n := len(text)
  let m := len(pattern)
  let fail := BuildFailure(pattern)
  let positions := []
  let posIdx := 0
  let k := 0
  for i := 0 to n - 1 do
    while k > 0 and pattern[k] != text[i] do
      k := fail[k - 1]
    end
    if pattern[k] == text[i] then
      k := k + 1
    end
    if k == m then
      positions[posIdx] := i - m + 1
      posIdx := posIdx + 1
      k := fail[k - 1]
    end
  end
  return positions
end

let text1 := "ababcabcababd"
let pat1 := "ababd"
let r1 := KMPSearch(text1, pat1)
print "Pattern '" & pat1 & "' in '" & text1 & "':"
foreach p in r1 do print "  at " & str(p) end

let text2 := "aaaaaa"
let pat2 := "aaa"
let r2 := KMPSearch(text2, pat2)
print "Pattern '" & pat2 & "' in '" & text2 & "':"
foreach p in r2 do print "  at " & str(p) end

let text3 := "hello world hello"
let pat3 := "hello"
let r3 := KMPSearch(text3, pat3)
print "Pattern '" & pat3 & "' in text:"
foreach p in r3 do print "  at " & str(p) end
