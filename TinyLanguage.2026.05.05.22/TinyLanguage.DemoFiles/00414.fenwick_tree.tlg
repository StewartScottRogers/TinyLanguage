# Data structure: Fenwick tree (binary indexed tree for prefix sums)
# Subroutines: Update, PrefixSum, RangeSum, Init, Size
# Workload: build array of 10 elements, compute prefix sums, range sums, update and re-query

class FenwickTree {
  let tree := []
  let n := 0

  Constructor(size)
    this.n := size
    for i := 0 to size do
      this.tree[i] := 0
    end
  end

  function Update(i, delta)
    let idx := i + 1
    while idx <= this.n do
      this.tree[idx] := this.tree[idx] + delta
      idx := idx + (idx & (-idx))
    end
  end

  function PrefixSum(i)
    let sum := 0
    let idx := i + 1
    while idx > 0 do
      sum := sum + this.tree[idx]
      idx := idx - (idx & (-idx))
    end
    return sum
  end

  function RangeSum(lo, hi)
    if lo == 0 then return this.PrefixSum(hi) end
    return this.PrefixSum(hi) - this.PrefixSum(lo - 1)
  end

  function Size()
    return this.n
  end
}

let arr := [3, 2, 5, 1, 4, 6, 7, 2, 8, 1]
let ft := new FenwickTree(10)
for i := 0 to 9 do
  ft.Update(i, arr[i])
end

print "PrefixSum(0..4): " & str(ft.PrefixSum(4))
print "PrefixSum(0..9): " & str(ft.PrefixSum(9))
print "RangeSum(2..6): " & str(ft.RangeSum(2, 6))
print "RangeSum(0..0): " & str(ft.RangeSum(0, 0))

ft.Update(3, 5)
print "After Update(3, +5):"
print "PrefixSum(0..3): " & str(ft.PrefixSum(3))
print "RangeSum(0..9): " & str(ft.RangeSum(0, 9))
