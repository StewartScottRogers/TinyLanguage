function rbSearch(arr, target, lo, hi)
  if lo > hi then
    return -1
  end
  let mid := (lo + hi) // 2
  if arr[mid] == target then
    return mid
  end
  if arr[mid] < target then
    return rbSearch(arr, target, mid + 1, hi)
  end
  return rbSearch(arr, target, lo, mid - 1)
end
let sorted := [2, 5, 8, 12, 16, 23, 38, 56, 72, 91]
print rbSearch(sorted, 23, 0, 9)
print rbSearch(sorted, 2, 0, 9)
print rbSearch(sorted, 91, 0, 9)
print rbSearch(sorted, 50, 0, 9)
