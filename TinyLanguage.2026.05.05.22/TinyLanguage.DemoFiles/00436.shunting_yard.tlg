# Data structure: two stacks (operator stack + output queue) for shunting-yard algorithm
# Subroutines: Precedence, IsOperator, ToPostfix, PrintTokens
# Workload: convert 5 infix expressions to postfix, verify output matches expected

class TokenStack {
  let data := []
  let top := -1
  function Push(x)
    this.top := this.top + 1
    this.data[this.top] := x
  end
  function Pop()
    if this.top < 0 then throw "empty" end
    let v := this.data[this.top]
    this.top := this.top - 1
    return v
  end
  function Peek()
    if this.top < 0 then return null end
    return this.data[this.top]
  end
  function IsEmpty()
    return this.top < 0
  end
}

function Precedence(op)
  if op == "+" or op == "-" then return 1 end
  if op == "*" or op == "/" then return 2 end
  return 0
end

function IsOperator(ch)
  return ch == "+" or ch == "-" or ch == "*" or ch == "/"
end

function ToPostfix(tokens)
  let opStack := new TokenStack()
  let output := []
  let outIdx := 0
  foreach tok in tokens do
    if tok == "(" then
      opStack.Push(tok)
    else
      if tok == ")" then
        while not opStack.IsEmpty() and opStack.Peek() != "(" do
          output[outIdx] := opStack.Pop()
          outIdx := outIdx + 1
        end
        if not opStack.IsEmpty() then opStack.Pop() end
      else
        if IsOperator(tok) then
          while not opStack.IsEmpty() and
                opStack.Peek() != "(" and
                Precedence(opStack.Peek()) >= Precedence(tok) do
            output[outIdx] := opStack.Pop()
            outIdx := outIdx + 1
          end
          opStack.Push(tok)
        else
          output[outIdx] := tok
          outIdx := outIdx + 1
        end
      end
    end
  end
  while not opStack.IsEmpty() do
    output[outIdx] := opStack.Pop()
    outIdx := outIdx + 1
  end
  let result := []
  for i := 0 to outIdx - 1 do
    result[i] := output[i]
  end
  return result
end

let expr1 := ["3", "+", "4", "*", "2"]
let r1 := ToPostfix(expr1)
let s1 := ""
foreach t in r1 do s1 := s1 & t & " " end
print "3+4*2 -> " & s1

let expr2 := ["(", "3", "+", "4", ")", "*", "2"]
let r2 := ToPostfix(expr2)
let s2 := ""
foreach t in r2 do s2 := s2 & t & " " end
print "(3+4)*2 -> " & s2

let expr3 := ["5", "+", "(", "1", "+", "2", ")", "*", "4", "-", "3"]
let r3 := ToPostfix(expr3)
let s3 := ""
foreach t in r3 do s3 := s3 & t & " " end
print "5+(1+2)*4-3 -> " & s3
