# Data structure: stack used to reverse strings
# Subroutines: Push, Pop, IsEmpty, ReverseString, IsPalindrome
# Workload: reverse 4 strings, check palindrome status for 6 words

class CharStack {
  let data := []
  let top := -1

  function Push(ch)
    this.top := this.top + 1
    this.data[this.top] := ch
  end

  function Pop()
    if this.top < 0 then throw "empty" end
    let v := this.data[this.top]
    this.top := this.top - 1
    return v
  end

  function IsEmpty()
    return this.top < 0
  end

  function Size()
    return this.top + 1
  end
}

function ReverseString(s)
  let stk := new CharStack()
  foreach ch in s do
    stk.Push(ch)
  end
  let result := ""
  while not stk.IsEmpty() do
    result := result & stk.Pop()
  end
  return result
end

function IsPalindrome(s)
  let reversed := ReverseString(s)
  let n := len(s)
  if n != len(reversed) then return false end
  for i := 0 to n - 1 do
    if s[i] != reversed[i] then return false end
  end
  return true
end

let strings := ["hello", "world", "TinyLanguage", "abcde"]
foreach s in strings do
  print "reverse('" & s & "') = '" & ReverseString(s) & "'"
end

let words := ["racecar", "hello", "level", "world", "madam", "noon"]
foreach w in words do
  print "isPalindrome('" & w & "') = " & str(IsPalindrome(w))
end
