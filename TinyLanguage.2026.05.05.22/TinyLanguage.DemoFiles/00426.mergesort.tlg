# Data structure: array sorted via merge sort
# Subroutines: MergeSort, Merge, Split, isSorted
# Workload: sort 12-element array with duplicates, verify sorted, verify stability hint

function MergeSortedHalves(arr, lo, mid, hi)
  let left := []
  let right := []
  let li := 0
  let ri := 0
  for i := lo to mid do
    left[li] := arr[i]
    li := li + 1
  end
  for i := mid + 1 to hi do
    right[ri] := arr[i]
    ri := ri + 1
  end
  let lc := li
  let rc := ri
  li := 0
  ri := 0
  let k := lo
  while li < lc and ri < rc do
    if left[li] <= right[ri] then
      arr[k] := left[li]
      li := li + 1
    else
      arr[k] := right[ri]
      ri := ri + 1
    end
    k := k + 1
  end
  while li < lc do
    arr[k] := left[li]
    li := li + 1
    k := k + 1
  end
  while ri < rc do
    arr[k] := right[ri]
    ri := ri + 1
    k := k + 1
  end
end

function MergeSort(arr, lo, hi)
  if lo >= hi then return end
  let mid := (lo + hi) // 2
  MergeSort(arr, lo, mid)
  MergeSort(arr, mid + 1, hi)
  MergeSortedHalves(arr, lo, mid, hi)
end

function isSorted(arr)
  let n := len(arr)
  for i := 0 to n - 2 do
    if arr[i] > arr[i + 1] then return false end
  end
  return true
end

let data := [6, 3, 8, 1, 9, 2, 7, 4, 5, 3, 8, 1]
let n := len(data)
MergeSort(data, 0, n - 1)
print "Sorted:"
foreach x in data do
  print x
end
print "Is sorted: " & str(isSorted(data))

let data2 := [1]
MergeSort(data2, 0, 0)
print "Single element sorted: " & str(isSorted(data2))

let data3 := [5, 4, 3, 2, 1]
MergeSort(data3, 0, 4)
print "Reverse sorted:"
foreach x in data3 do print x end
