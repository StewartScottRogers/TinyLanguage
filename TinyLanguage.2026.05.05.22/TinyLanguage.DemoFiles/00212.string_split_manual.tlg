function countWords(s)
  let count := 0
  let inWord := false
  foreach ch in s do
    if ch == " " then
      if inWord then
        count := count + 1
        inWord := false
      end
    else
      inWord := true
    end
  end
  if inWord then
    count := count + 1
  end
  return count
end
print countWords("hello world foo bar")
print countWords("one")
print countWords("  spaces  ")
