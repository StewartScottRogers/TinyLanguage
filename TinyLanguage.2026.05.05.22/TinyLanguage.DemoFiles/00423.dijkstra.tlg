# Data structure: weighted graph for Dijkstra shortest path
# Subroutines: AddEdge, Dijkstra, PathCost, PrintPath
# Workload: 6-node weighted graph, shortest paths from node 0 to all others

class DijkstraGraph {
  let adjNodes := []
  let adjWeights := []
  let adjSize := []
  let n := 0
  let INF := 999999

  Constructor(numVerts)
    this.n := numVerts
    for i := 0 to numVerts - 1 do
      this.adjNodes[i] := []
      this.adjWeights[i] := []
      this.adjSize[i] := 0
    end
  end

  function AddEdge(u, v, w)
    this.adjNodes[u][this.adjSize[u]] := v
    this.adjWeights[u][this.adjSize[u]] := w
    this.adjSize[u] := this.adjSize[u] + 1
    this.adjNodes[v][this.adjSize[v]] := u
    this.adjWeights[v][this.adjSize[v]] := w
    this.adjSize[v] := this.adjSize[v] + 1
  end

  function Dijkstra(src)
    let dist := []
    let visited := []
    for i := 0 to this.n - 1 do
      dist[i] := this.INF
      visited[i] := false
    end
    dist[src] := 0
    for iter := 0 to this.n - 1 do
      let u := -1
      for i := 0 to this.n - 1 do
        if not visited[i] and (u == -1 or dist[i] < dist[u]) then
          u := i
        end
      end
      if u == -1 or dist[u] == this.INF then return dist end
      visited[u] := true
      for i := 0 to this.adjSize[u] - 1 do
        let v := this.adjNodes[u][i]
        let w := this.adjWeights[u][i]
        if dist[u] + w < dist[v] then
          dist[v] := dist[u] + w
        end
      end
    end
    return dist
  end
}

let g := new DijkstraGraph(6)
g.AddEdge(0, 1, 4)
g.AddEdge(0, 2, 1)
g.AddEdge(2, 1, 2)
g.AddEdge(1, 3, 5)
g.AddEdge(2, 3, 8)
g.AddEdge(3, 4, 2)
g.AddEdge(4, 5, 3)
g.AddEdge(3, 5, 6)

let dist := g.Dijkstra(0)
print "Shortest distances from vertex 0:"
for i := 0 to 5 do
  print "  to " & str(i) & ": " & str(dist[i])
end
