# Data structure: priority queue (min-heap based, stores value+priority pairs)
# Subroutines: Enqueue, Dequeue, Peek, Size, IsEmpty
# Workload: enqueue 8 tasks with priorities, dequeue all in priority order, verify ordering

class PQNode {
  let value := ""
  let priority := 0
  Constructor(v, p)
    this.value := v
    this.priority := p
  end
}

class PriorityQueue {
  let data := []
  let size := 0

  function Enqueue(value, priority)
    this.data[this.size] := new PQNode(value, priority)
    this.size := this.size + 1
    this.heapifyUp(this.size - 1)
  end

  function heapifyUp(i)
    while i > 0 do
      let parent := (i - 1) // 2
      if this.data[i].priority < this.data[parent].priority then
        let tmp := this.data[i]
        this.data[i] := this.data[parent]
        this.data[parent] := tmp
        i := parent
      else
        return
      end
    end
  end

  function Dequeue()
    if this.size == 0 then throw "priority queue empty" end
    let top := this.data[0]
    this.size := this.size - 1
    this.data[0] := this.data[this.size]
    this.heapifyDown(0)
    return top
  end

  function heapifyDown(i)
    while true do
      let left := 2 * i + 1
      let right := 2 * i + 2
      let smallest := i
      if left < this.size and this.data[left].priority < this.data[smallest].priority then
        smallest := left
      end
      if right < this.size and this.data[right].priority < this.data[smallest].priority then
        smallest := right
      end
      if smallest == i then return end
      let tmp := this.data[i]
      this.data[i] := this.data[smallest]
      this.data[smallest] := tmp
      i := smallest
    end
  end

  function Peek()
    if this.size == 0 then return null end
    return this.data[0]
  end

  function Size()
    return this.size
  end

  function IsEmpty()
    return this.size == 0
  end
}

let pq := new PriorityQueue()
pq.Enqueue("send email", 3)
pq.Enqueue("fix crash", 1)
pq.Enqueue("write tests", 2)
pq.Enqueue("deploy", 2)
pq.Enqueue("code review", 4)
pq.Enqueue("emergency patch", 0)
pq.Enqueue("update docs", 5)
pq.Enqueue("refactor", 3)

print "Size: " & str(pq.Size())
print "Peek: " & pq.Peek().value & " (priority " & str(pq.Peek().priority) & ")"
print "Dequeue order (by priority):"
while not pq.IsEmpty() do
  let item := pq.Dequeue()
  print str(item.priority) & ": " & item.value
end
