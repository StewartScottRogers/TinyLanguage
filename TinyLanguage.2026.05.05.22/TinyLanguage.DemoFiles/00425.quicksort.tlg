# Data structure: array sorted in-place via quicksort
# Subroutines: QuickSort, Partition, MedianOfThree, Swap
# Workload: sort arrays of sizes 1, 5, 15 with repeated elements; verify sorted order

function Swap(arr, i, j)
  let tmp := arr[i]
  arr[i] := arr[j]
  arr[j] := tmp
end

function Partition(arr, lo, hi)
  let pivot := arr[hi]
  let i := lo - 1
  for j := lo to hi - 1 do
    if arr[j] <= pivot then
      i := i + 1
      Swap(arr, i, j)
    end
  end
  Swap(arr, i + 1, hi)
  return i + 1
end

function QuickSort(arr, lo, hi)
  if lo >= hi then return end
  let p := Partition(arr, lo, hi)
  QuickSort(arr, lo, p - 1)
  QuickSort(arr, p + 1, hi)
end

function isSorted(arr)
  let n := len(arr)
  for i := 0 to n - 2 do
    if arr[i] > arr[i + 1] then return false end
  end
  return true
end

let a1 := [42]
QuickSort(a1, 0, 0)
print "Size 1 sorted: " & str(isSorted(a1))

let a2 := [5, 3, 1, 4, 2]
QuickSort(a2, 0, 4)
print "Sorted 5 elements:"
foreach x in a2 do print x end

let a3 := [9, 3, 7, 1, 5, 8, 2, 6, 4, 10, 3, 7, 1, 5, 8]
QuickSort(a3, 0, 14)
print "Sorted 15 elements (with repeats):"
foreach x in a3 do print x end
print "Is sorted: " & str(isSorted(a3))
