function isPrime(n)
  if n < 2 then
    return false
  end
  let i := 2
  while i * i <= n do
    if n % i == 0 then
      return false
    end
    i := i + 1
  end
  return true
end
let count := 0
for i := 2 to 50 do
  if isPrime(i) then
    print i
    count := count + 1
  end
end
print "count: " & str(count)
