class Matrix2x2 {
  let a := 0.0
  let b := 0.0
  let c := 0.0
  let d := 0.0
  Constructor(pa, pb, pc, pd)
    this.a := pa
    this.b := pb
    this.c := pc
    this.d := pd
  end
  function det()
    return this.a * this.d - this.b * this.c
  end
  function trace()
    return this.a + this.d
  end
  function toString()
    return "[" & str(this.a) & " " & str(this.b) & "; " & str(this.c) & " " & str(this.d) & "]"
  end
}
let m := new Matrix2x2(1.0, 2.0, 3.0, 4.0)
print m.toString()
print m.det()
print m.trace()
