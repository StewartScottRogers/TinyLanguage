# Data structure: queue (array-based with head/tail pointers)
# Subroutines: Enqueue, Dequeue, Peek, IsEmpty, Size
# Workload: enqueue 8 items, dequeue 3, peek, enqueue 2 more, dequeue all, verify FIFO order

class Queue {
  let data := []
  let head := 0
  let tail := 0

  function Enqueue(x)
    this.data[this.tail] := x
    this.tail := this.tail + 1
  end

  function Dequeue()
    if this.head == this.tail then throw "queue empty" end
    let v := this.data[this.head]
    this.head := this.head + 1
    return v
  end

  function Peek()
    if this.head == this.tail then return null end
    return this.data[this.head]
  end

  function IsEmpty()
    return this.head == this.tail
  end

  function Size()
    return this.tail - this.head
  end
}

let q := new Queue()
let insertOrder := []
let dequeueOrder := []
let iIdx := 0
let dIdx := 0

for i := 1 to 8 do
  q.Enqueue(i * 10)
  insertOrder[iIdx] := i * 10
  iIdx := iIdx + 1
end

print "Size after 8 enqueues: " & str(q.Size())
print "Peek: " & str(q.Peek())

for i := 1 to 3 do
  let v := q.Dequeue()
  dequeueOrder[dIdx] := v
  dIdx := dIdx + 1
end

print "After 3 dequeues, size: " & str(q.Size())
q.Enqueue(90)
q.Enqueue(100)
print "After 2 more enqueues, size: " & str(q.Size())

while not q.IsEmpty() do
  let v := q.Dequeue()
  dequeueOrder[dIdx] := v
  dIdx := dIdx + 1
end

print "Dequeue order (should be 10,20,30,...,80,90,100):"
for i := 0 to dIdx - 1 do
  print dequeueOrder[i]
end
print "FIFO verified: " & str(dequeueOrder[0] == 10)
