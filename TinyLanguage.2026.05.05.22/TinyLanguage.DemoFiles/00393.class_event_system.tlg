class EventEmitter {
  let listeners := []
  let count := 0
  function on(handler)
    this.listeners[this.count] := handler
    this.count := this.count + 1
  end
  function emit(event, data)
    for i := 0 to this.count - 1 do
      this.listeners[i](event, data)
    end
  end
}
let emitter := new EventEmitter()
emitter.on(function(e, d) print "Listener1: " & e & " - " & str(d) end)
emitter.on(function(e, d) print "Listener2 count: " & str(d * 2) end)
emitter.emit("click", 5)
emitter.emit("keypress", 42)
