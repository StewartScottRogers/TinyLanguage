class Vehicle {
  let speed := 0
  function describe()
    return "Vehicle at speed " & str(this.speed)
  end
}
class Car extends Vehicle {
  let doors := 4
  Constructor(s, d)
    this.speed := s
    this.doors := d
  end
  function describe()
    return "Car with " & str(this.doors) & " doors at " & str(this.speed)
  end
}
let car := new Car(60, 2)
print car.describe()
print car.speed
print car.doors
