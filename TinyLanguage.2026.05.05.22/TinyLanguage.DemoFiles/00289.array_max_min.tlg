function arrayMax(arr)
  let m := arr[0]
  foreach item in arr do
    if item > m then
      m := item
    end
  end
  return m
end
function arrayMin(arr)
  let m := arr[0]
  foreach item in arr do
    if item < m then
      m := item
    end
  end
  return m
end
let data := [3, 1, 4, 1, 5, 9, 2, 6, 5, 3]
print arrayMax(data)
print arrayMin(data)
