# Data structure: singly linked list
# Subroutines: PushFront, PushBack, Remove, Find, Length, PrintAll
# Workload: build list of 10 ints, remove odds, find remaining evens, print in order

class SNode {
  let val := 0
  let next := null
  Constructor(v)
    this.val := v
  end
}

class SinglyLinkedList {
  let head := null
  let size := 0

  function PushFront(v)
    let node := new SNode(v)
    node.next := this.head
    this.head := node
    this.size := this.size + 1
  end

  function PushBack(v)
    let node := new SNode(v)
    if this.head == null then
      this.head := node
    else
      let cur := this.head
      while cur.next != null do
        cur := cur.next
      end
      cur.next := node
    end
    this.size := this.size + 1
  end

  function Remove(v)
    if this.head == null then return end
    if this.head.val == v then
      this.head := this.head.next
      this.size := this.size - 1
      return
    end
    let cur := this.head
    while cur.next != null and cur.next.val != v do
      cur := cur.next
    end
    if cur.next != null then
      cur.next := cur.next.next
      this.size := this.size - 1
    end
  end

  function Find(v)
    let cur := this.head
    let pos := 0
    while cur != null do
      if cur.val == v then return pos end
      cur := cur.next
      pos := pos + 1
    end
    return -1
  end

  function Length()
    return this.size
  end

  function PrintAll()
    let cur := this.head
    while cur != null do
      print cur.val
      cur := cur.next
    end
  end
}

let list := new SinglyLinkedList()
for i := 1 to 10 do
  list.PushBack(i)
end
print "Length before remove: " & str(list.Length())

for i := 1 to 10 do
  if i % 2 != 0 then
    list.Remove(i)
  end
end
print "Length after removing odds: " & str(list.Length())

print "Find 4: " & str(list.Find(4))
print "Find 7: " & str(list.Find(7))
print "Remaining elements:"
list.PrintAll()
