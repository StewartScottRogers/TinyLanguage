class Color {
  let r := 0
  let g := 0
  let b := 0
  Constructor(red, green, blue)
    this.r := red
    this.g := green
    this.b := blue
  end
  function toHex()
    return "rgb(" & str(this.r) & "," & str(this.g) & "," & str(this.b) & ")"
  end
  function brightness()
    return (this.r + this.g + this.b) / 3
  end
  function isDark()
    return this.brightness() < 128
  end
}
let red := new Color(255, 0, 0)
let dark := new Color(10, 20, 30)
print red.toHex()
print red.brightness()
print red.isDark()
print dark.toHex()
print dark.isDark()
