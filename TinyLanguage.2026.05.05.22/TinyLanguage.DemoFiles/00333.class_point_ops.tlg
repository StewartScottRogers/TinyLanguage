class Point {
  let x := 0.0
  let y := 0.0
  Constructor(px, py)
    this.x := px
    this.y := py
  end
  function add(other)
    return new Point(this.x + other.x, this.y + other.y)
  end
  function scale(factor)
    return new Point(this.x * factor, this.y * factor)
  end
  function toString()
    return "(" & str(this.x) & ", " & str(this.y) & ")"
  end
}
let p1 := new Point(1.0, 2.0)
let p2 := new Point(3.0, 4.0)
let p3 := p1.add(p2)
print p3.toString()
let p4 := p1.scale(3.0)
print p4.toString()
