function validateAge(age)
  if age < 0 then
    throw "Age cannot be negative: " & str(age)
  end
  if age > 150 then
    throw "Age is unrealistic: " & str(age)
  end
  return "valid"
end
try
  print validateAge(25)
  print validateAge(-1)
catch e
  print "Error: " & e
end
try
  print validateAge(200)
catch e
  print "Error: " & e
end
