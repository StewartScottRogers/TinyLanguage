# Data structure: DAG for topological ordering
# Subroutines: AddEdge, TopologicalSort, HasCycle, DFS
# Workload: 6-task dependency graph, compute valid execution order (deterministic)

class TopoGraph {
  let adj := []
  let adjSize := []
  let n := 0

  Constructor(numVerts)
    this.n := numVerts
    for i := 0 to numVerts - 1 do
      this.adj[i] := []
      this.adjSize[i] := 0
    end
  end

  function AddEdge(u, v)
    this.adj[u][this.adjSize[u]] := v
    this.adjSize[u] := this.adjSize[u] + 1
  end

  function topoHelper(v, visited, stack, stackTop)
    visited[v] := true
    for i := 0 to this.adjSize[v] - 1 do
      let u := this.adj[v][i]
      if not visited[u] then
        this.topoHelper(u, visited, stack, stackTop)
      end
    end
    stack[stackTop[0]] := v
    stackTop[0] := stackTop[0] + 1
  end

  function TopologicalSort()
    let visited := []
    let stack := []
    for i := 0 to this.n - 1 do
      visited[i] := false
    end
    let stackTop := [0]
    for i := 0 to this.n - 1 do
      if not visited[i] then
        this.topoHelper(i, visited, stack, stackTop)
      end
    end
    let result := []
    let sz := stackTop[0]
    for i := 0 to sz - 1 do
      result[i] := stack[sz - 1 - i]
    end
    return result
  end
}

let g := new TopoGraph(6)
g.AddEdge(5, 2)
g.AddEdge(5, 0)
g.AddEdge(4, 0)
g.AddEdge(4, 1)
g.AddEdge(2, 3)
g.AddEdge(3, 1)

print "Topological order:"
let order := g.TopologicalSort()
foreach v in order do
  print v
end
