# Data structure: DP array for Longest Increasing Subsequence
# Subroutines: LIS, BuildDP, Reconstruct, LISLength
# Workload: compute LIS for 4 input sequences, print length and one LIS

function BuildLISDP(arr)
  let n := len(arr)
  let dp := []
  let parent := []
  for i := 0 to n - 1 do
    dp[i] := 1
    parent[i] := -1
  end
  for i := 1 to n - 1 do
    for j := 0 to i - 1 do
      if arr[j] < arr[i] and dp[j] + 1 > dp[i] then
        dp[i] := dp[j] + 1
        parent[i] := j
      end
    end
  end
  return [dp, parent]
end

function LISLength(arr)
  let result := BuildLISDP(arr)
  let dp := result[0]
  let n := len(dp)
  let best := 0
  for i := 0 to n - 1 do
    if dp[i] > best then best := dp[i] end
  end
  return best
end

function ReconstructLIS(arr)
  let result := BuildLISDP(arr)
  let dp := result[0]
  let parent := result[1]
  let n := len(dp)
  let best := 0
  let bestIdx := 0
  for i := 0 to n - 1 do
    if dp[i] > best then
      best := dp[i]
      bestIdx := i
    end
  end
  let seq := []
  let seqLen := 0
  let cur := bestIdx
  while cur != -1 do
    seq[seqLen] := arr[cur]
    seqLen := seqLen + 1
    cur := parent[cur]
  end
  let reversed := []
  for i := 0 to seqLen - 1 do
    reversed[i] := seq[seqLen - 1 - i]
  end
  return reversed
end

let sequences := [
  [10, 9, 2, 5, 3, 7, 101, 18],
  [0, 1, 0, 3, 2, 3],
  [7, 7, 7, 7, 7],
  [1, 3, 6, 7, 9, 4, 10, 5, 6]
]

foreach seq in sequences do
  let length := LISLength(seq)
  let lis := ReconstructLIS(seq)
  let display := ""
  foreach x in seq do display := display & str(x) & " " end
  let lisStr := ""
  foreach x in lis do lisStr := lisStr & str(x) & " " end
  print "LIS([" & display & "]) = " & str(length) & " [" & lisStr & "]"
end
