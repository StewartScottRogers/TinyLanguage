# Data structure: deque (double-ended queue)
# Subroutines: PushFront, PushBack, PopFront, PopBack, PeekFront, PeekBack, Size
# Workload: 8+ distinct operations mixing front/back push/pop, verifying deque semantics

class Deque {
  let data := []
  let front := 500
  let back := 500

  function PushFront(x)
    this.front := this.front - 1
    this.data[this.front] := x
  end

  function PushBack(x)
    this.data[this.back] := x
    this.back := this.back + 1
  end

  function PopFront()
    if this.front == this.back then throw "deque empty" end
    let v := this.data[this.front]
    this.front := this.front + 1
    return v
  end

  function PopBack()
    if this.front == this.back then throw "deque empty" end
    this.back := this.back - 1
    return this.data[this.back]
  end

  function PeekFront()
    if this.front == this.back then return null end
    return this.data[this.front]
  end

  function PeekBack()
    if this.front == this.back then return null end
    return this.data[this.back - 1]
  end

  function Size()
    return this.back - this.front
  end

  function IsEmpty()
    return this.front == this.back
  end
}

let dq := new Deque()
print "Empty: " & str(dq.IsEmpty())
dq.PushBack(1)
dq.PushBack(2)
dq.PushBack(3)
dq.PushFront(0)
dq.PushFront(-1)
print "Size: " & str(dq.Size())
print "PeekFront: " & str(dq.PeekFront())
print "PeekBack: " & str(dq.PeekBack())
print "PopFront: " & str(dq.PopFront())
print "PopBack: " & str(dq.PopBack())
print "Size after pops: " & str(dq.Size())
print "Drain front:"
while not dq.IsEmpty() do
  print dq.PopFront()
end
print "Empty: " & str(dq.IsEmpty())
