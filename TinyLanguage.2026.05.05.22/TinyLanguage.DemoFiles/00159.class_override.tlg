class Shape {
  function area()
    return 0
  end
  function name()
    return "Shape"
  end
}
class Circle extends Shape {
  let radius := 0
  Constructor(r)
    this.radius := r
  end
  function area()
    return 3.14159 * this.radius * this.radius
  end
  function name()
    return "Circle"
  end
}
let c := new Circle(5)
print c.name()
print c.area()
