function isPalindrome(s)
  let left := 0
  let right := len(s) - 1
  while left < right do
    if s[left] != s[right] then
      return false
    end
    left := left + 1
    right := right - 1
  end
  return true
end
print isPalindrome("racecar")
print isPalindrome("hello")
print isPalindrome("level")
