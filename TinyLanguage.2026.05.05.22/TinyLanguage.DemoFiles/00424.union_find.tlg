# Data structure: union-find (disjoint set) with path compression and union by rank
# Subroutines: Find, Union, Connected, ComponentCount, Init
# Workload: 10 elements, union 6 pairs, verify connectivity, count components

class UnionFind {
  let parent := []
  let rank := []
  let n := 0

  Constructor(size)
    this.n := size
    for i := 0 to size - 1 do
      this.parent[i] := i
      this.rank[i] := 0
    end
  end

  function Find(x)
    if this.parent[x] != x then
      this.parent[x] := this.Find(this.parent[x])
    end
    return this.parent[x]
  end

  function Union(x, y)
    let px := this.Find(x)
    let py := this.Find(y)
    if px == py then return false end
    if this.rank[px] < this.rank[py] then
      let tmp := px
      px := py
      py := tmp
    end
    this.parent[py] := px
    if this.rank[px] == this.rank[py] then
      this.rank[px] := this.rank[px] + 1
    end
    return true
  end

  function Connected(x, y)
    return this.Find(x) == this.Find(y)
  end

  function ComponentCount()
    let count := 0
    for i := 0 to this.n - 1 do
      if this.Find(i) == i then
        count := count + 1
      end
    end
    return count
  end
}

let uf := new UnionFind(10)
print "Initial components: " & str(uf.ComponentCount())

uf.Union(0, 1)
uf.Union(1, 2)
uf.Union(3, 4)
uf.Union(5, 6)
uf.Union(6, 7)
uf.Union(7, 8)

print "After unions, components: " & str(uf.ComponentCount())
print "Connected(0, 2): " & str(uf.Connected(0, 2))
print "Connected(0, 3): " & str(uf.Connected(0, 3))
print "Connected(5, 8): " & str(uf.Connected(5, 8))
print "Connected(9, 0): " & str(uf.Connected(9, 0))

uf.Union(2, 3)
print "After Union(2,3), components: " & str(uf.ComponentCount())
print "Connected(0, 4): " & str(uf.Connected(0, 4))
