function categorize(x)
  match x {
    0 => return "zero"
    1 | 2 | 3 => return "small"
    n when n < 0 => return "negative"
    n when n < 100 => return "medium"
    _ => return "large"
  }
end
print categorize(0)
print categorize(2)
print categorize(-5)
print categorize(50)
print categorize(500)
