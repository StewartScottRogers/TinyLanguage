function flatten(nested)
  let result := []
  let idx := 0
  foreach row in nested do
    foreach item in row do
      result[idx] := item
      idx := idx + 1
    end
  end
  return result
end
let nested := [[1, 2, 3], [4, 5], [6, 7, 8, 9]]
let flat := flatten(nested)
foreach item in flat do
  print item
end
