class Accumulator {
  let total := 0.0
  let count := 0
  function add(x)
    this.total := this.total + x
    this.count := this.count + 1
  end
  function mean()
    if this.count == 0 then
      return 0.0
    end
    return this.total / (float) this.count
  end
  function sum()
    return this.total
  end
  function n()
    return this.count
  end
}
let acc := new Accumulator()
acc.add(10.0)
acc.add(20.0)
acc.add(30.0)
acc.add(40.0)
print acc.sum()
print acc.n()
print acc.mean()
