class Mutable {
  var counter : int := 0
  var name : string := "default"
  function setName(n)
    this.name := n
  end
  function tick()
    this.counter := this.counter + 1
  end
  function status()
    return this.name & ": " & str(this.counter)
  end
}
let m := new Mutable()
m.setName("test")
m.tick()
m.tick()
m.tick()
print m.status()
