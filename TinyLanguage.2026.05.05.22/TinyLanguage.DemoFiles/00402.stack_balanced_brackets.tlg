# Data structure: stack
# Subroutines: Push, Pop, Peek, IsEmpty, Size
# Workload: balanced bracket checker exercises push/pop/peek on 8 distinct inputs

class Stack {
  let data := []
  let top := -1

  function Push(x)
    this.top := this.top + 1
    this.data[this.top] := x
  end

  function Pop()
    if this.top < 0 then throw "stack underflow" end
    let v := this.data[this.top]
    this.top := this.top - 1
    return v
  end

  function Peek()
    if this.top < 0 then return null end
    return this.data[this.top]
  end

  function IsEmpty()
    return this.top < 0
  end

  function Size()
    return this.top + 1
  end
}

function isBalanced(s)
  let stk := new Stack()
  foreach ch in s do
    if ch == "(" or ch == "[" or ch == "{" then
      stk.Push(ch)
    else
      if ch == ")" or ch == "]" or ch == "}" then
        if stk.IsEmpty() then return false end
        let top := stk.Pop()
        if ch == ")" and top != "(" then return false end
        if ch == "]" and top != "[" then return false end
        if ch == "}" and top != "{" then return false end
      end
    end
  end
  return stk.IsEmpty()
end

let tests := [
  "()",
  "[]",
  "{}",
  "([{}])",
  "([)]",
  "(((",
  "",
  "({[]})()"
]

foreach t in tests do
  let result := isBalanced(t)
  print t & " => " & str(result)
end
