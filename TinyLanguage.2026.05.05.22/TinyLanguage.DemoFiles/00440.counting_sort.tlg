# Data structure: frequency count array for counting sort
# Subroutines: CountingSort, BuildFrequency, PrefixCount, Scatter
# Workload: sort 15-element array with values 0-9, verify stability with repeated elements

function CountingSort(arr, maxVal)
  let freq := []
  for i := 0 to maxVal do
    freq[i] := 0
  end
  foreach x in arr do
    freq[x] := freq[x] + 1
  end
  let prefix := []
  prefix[0] := 0
  for i := 1 to maxVal do
    prefix[i] := prefix[i - 1] + freq[i - 1]
  end
  let result := []
  let n := len(arr)
  for i := 0 to n - 1 do
    result[i] := 0
  end
  for i := 0 to n - 1 do
    let x := arr[i]
    result[prefix[x]] := x
    prefix[x] := prefix[x] + 1
  end
  return result
end

function isSorted(arr)
  let n := len(arr)
  for i := 0 to n - 2 do
    if arr[i] > arr[i + 1] then return false end
  end
  return true
end

let data := [4, 2, 7, 1, 9, 0, 3, 8, 5, 6, 4, 2, 7, 1, 9]
let sorted := CountingSort(data, 9)
print "Counting sorted:"
foreach x in sorted do print x end
print "Is sorted: " & str(isSorted(sorted))
