function depth(arr, level)
  let result := ""
  for i := 0 to len(arr) - 1 do
    let indent := ""
    for j := 0 to level - 1 do
      indent := indent & "  "
    end
    result := result & indent & str(arr[i]) & "\n"
  end
  return result
end
let items := [1, 2, 3, 4, 5]
print depth(items, 0)
print depth(items, 2)
