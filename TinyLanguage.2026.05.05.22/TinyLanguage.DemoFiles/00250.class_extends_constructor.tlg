class Base {
  let x := 0
  Constructor(v)
    this.x := v
  end
  function getX()
    return this.x
  end
}
class Derived extends Base {
  let y := 0
  Constructor(v, w)
    this.x := v
    this.y := w
  end
  function sum()
    return this.x + this.y
  end
}
let d := new Derived(3, 4)
print d.getX()
print d.sum()
