function lowerBound(arr, target)
  let lo := 0
  let hi := len(arr)
  while lo < hi do
    let mid := (lo + hi) // 2
    if arr[mid] < target then
      lo := mid + 1
    else
      hi := mid
    end
  end
  return lo
end
let sorted := [1, 2, 2, 3, 3, 3, 4, 5]
print lowerBound(sorted, 2)
print lowerBound(sorted, 3)
print lowerBound(sorted, 4)
print lowerBound(sorted, 6)
