class Point {
  let x := 0
  let y := 0
  Constructor(px, py)
    this.x := px
    this.y := py
  end
  function distFromOrigin()
    return this.x * this.x + this.y * this.y
  end
  function toString()
    return "(" & str(this.x) & "," & str(this.y) & ")"
  end
}
let p := new Point(3, 4)
print p.toString()
print p.distFromOrigin()
