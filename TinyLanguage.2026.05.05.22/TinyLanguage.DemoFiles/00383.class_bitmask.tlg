class Flags {
  let mask := 0
  function set(bit)
    this.mask := this.mask + bit
  end
  function unset(bit)
    this.mask := this.mask - bit
  end
  function has(bit)
    return this.mask % (bit * 2) >= bit
  end
  function value()
    return this.mask
  end
}
let f := new Flags()
f.set(1)
f.set(4)
f.set(8)
print f.value()
print f.has(4)
print f.has(2)
f.unset(4)
print f.has(4)
