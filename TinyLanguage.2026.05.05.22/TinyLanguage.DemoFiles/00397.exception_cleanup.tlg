let resources := []
let rcount := 0
function acquireResource(name)
  resources[rcount] := name
  rcount := rcount + 1
  return name
end
function releaseAll()
  for i := 0 to rcount - 1 do
    print "releasing: " & resources[i]
  end
end
try
  let r1 := acquireResource("fileHandle")
  let r2 := acquireResource("networkConn")
  throw "simulated failure"
catch e
  print "Error: " & e
finally
  releaseAll()
end
