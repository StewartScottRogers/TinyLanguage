function process(x)
  if x < 0 then
    throw "NegativeError: " & str(x)
  end
  if x > 1000 then
    throw "OverflowError: " & str(x)
  end
  return x * 2
end
let tests := [-5, 500, 2000]
foreach t in tests do
  try
    let result := process(t)
    print "OK: " & str(result)
  catch e
    print "Error: " & e
  end
end
