# Data structure: graph with BFS traversal
# Subroutines: AddEdge, BFS, LevelOrder, Distance
# Workload: 7-node graph, BFS from source 0, verify level-order and distances

class BFSGraph {
  let adj := []
  let adjSize := []
  let n := 0

  Constructor(numVerts)
    this.n := numVerts
    for i := 0 to numVerts - 1 do
      this.adj[i] := []
      this.adjSize[i] := 0
    end
  end

  function AddEdge(u, v)
    this.adj[u][this.adjSize[u]] := v
    this.adjSize[u] := this.adjSize[u] + 1
    this.adj[v][this.adjSize[v]] := u
    this.adjSize[v] := this.adjSize[v] + 1
  end

  function BFS(start)
    let visited := []
    let dist := []
    for i := 0 to this.n - 1 do
      visited[i] := false
      dist[i] := -1
    end
    let queue := []
    let qHead := 0
    let qTail := 0
    visited[start] := true
    dist[start] := 0
    queue[qTail] := start
    qTail := qTail + 1
    while qHead < qTail do
      let v := queue[qHead]
      qHead := qHead + 1
      print "Visit: " & str(v) & " (dist=" & str(dist[v]) & ")"
      for i := 0 to this.adjSize[v] - 1 do
        let u := this.adj[v][i]
        if not visited[u] then
          visited[u] := true
          dist[u] := dist[v] + 1
          queue[qTail] := u
          qTail := qTail + 1
        end
      end
    end
    return dist
  end
}

let g := new BFSGraph(7)
g.AddEdge(0, 1)
g.AddEdge(0, 2)
g.AddEdge(1, 3)
g.AddEdge(1, 4)
g.AddEdge(2, 5)
g.AddEdge(2, 6)

print "BFS from 0:"
let dists := g.BFS(0)
print "Distances from 0:"
for i := 0 to 6 do
  print "  " & str(i) & ": " & str(dists[i])
end
