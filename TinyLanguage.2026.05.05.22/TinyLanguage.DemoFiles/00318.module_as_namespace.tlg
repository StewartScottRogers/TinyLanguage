module Geo {
  function area_circle(r)
    return 3.14159 * r * r
  end
  function area_rect(w, h)
    return w * h
  end
  function area_triangle(base, height)
    return 0.5 * base * height
  end
  export area_circle
  export area_rect
  export area_triangle
}
print Geo.area_circle(5.0)
print Geo.area_rect(4, 6)
print Geo.area_triangle(3.0, 4.0)
