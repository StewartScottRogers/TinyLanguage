# Data structure: 2D DP table for Levenshtein edit distance
# Subroutines: EditDistance, OperationsNeeded, BuildDP
# Workload: compute edit distance for 5 string pairs, verify triangle inequality

function BuildEditDP(s1, s2)
  let m := len(s1)
  let n := len(s2)
  let dp := []
  for i := 0 to m do
    dp[i] := []
    for j := 0 to n do
      if i == 0 then dp[i][j] := j
      else if j == 0 then dp[i][j] := i
      else dp[i][j] := 0 end
    end
  end
  for i := 1 to m do
    for j := 1 to n do
      if s1[i - 1] == s2[j - 1] then
        dp[i][j] := dp[i - 1][j - 1]
      else
        let a := dp[i - 1][j] + 1
        let b := dp[i][j - 1] + 1
        let c := dp[i - 1][j - 1] + 1
        if a <= b and a <= c then dp[i][j] := a
        else if b <= c then dp[i][j] := b
        else dp[i][j] := c end
      end
    end
  end
  return dp
end

function EditDistance(s1, s2)
  let dp := BuildEditDP(s1, s2)
  return dp[len(s1)][len(s2)]
end

let pairs := [
  ["kitten", "sitting"],
  ["saturday", "sunday"],
  ["abc", "abc"],
  ["", "hello"],
  ["intention", "execution"]
]

foreach pair in pairs do
  let s1 := pair[0]
  let s2 := pair[1]
  let d := EditDistance(s1, s2)
  print "edit('" & s1 & "', '" & s2 & "') = " & str(d)
end
