function binarySearch(arr, target)
  let lo := 0
  let hi := len(arr) - 1
  while lo <= hi do
    let mid := (lo + hi) // 2
    if arr[mid] == target then
      return mid
    else
      if arr[mid] < target then
        lo := mid + 1
      else
        hi := mid - 1
      end
    end
  end
  return -1
end
let sorted := [1, 3, 5, 7, 9, 11, 13, 15]
print binarySearch(sorted, 7)
print binarySearch(sorted, 1)
print binarySearch(sorted, 15)
print binarySearch(sorted, 6)
