class Animal {
  let name := "unknown"
  Constructor(n)
    this.name := n
  end
  function sound()
    return "..."
  end
  function toString()
    return this.name & " says " & this.sound()
  end
}
class Cat extends Animal {
  function sound()
    return "meow"
  end
}
class Dog extends Animal {
  function sound()
    return "woof"
  end
}
let cat := new Cat("Whiskers")
let dog := new Dog("Rex")
print cat.toString()
print dog.toString()
