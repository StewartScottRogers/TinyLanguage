class Rectangle {
  let width := 0
  let height := 0
  Constructor(w, h)
    this.width := w
    this.height := h
  end
  function area()
    return this.width * this.height
  end
  function perimeter()
    return 2 * (this.width + this.height)
  end
  function isSquare()
    return this.width == this.height
  end
}
let r := new Rectangle(4, 5)
print r.area()
print r.perimeter()
print r.isSquare()
let s := new Rectangle(5, 5)
print s.isSquare()
