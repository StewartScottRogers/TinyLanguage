function zip(a, b)
  let size := len(a)
  if len(b) < size then
    size := len(b)
  end
  let result := []
  for i := 0 to size - 1 do
    result[i] := [a[i], b[i]]
  end
  return result
end
let keys := ["a", "b", "c"]
let vals := [1, 2, 3]
let pairs := zip(keys, vals)
foreach pair in pairs do
  print pair[0] & " -> " & str(pair[1])
end
