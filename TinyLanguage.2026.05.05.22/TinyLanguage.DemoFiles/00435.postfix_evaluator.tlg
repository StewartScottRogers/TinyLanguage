# Data structure: stack for postfix expression evaluation
# Subroutines: Push, Pop, Peek, Evaluate, ParseToken
# Workload: evaluate 6 postfix expressions, verify results

class NumStack {
  let data := []
  let top := -1

  function Push(x)
    this.top := this.top + 1
    this.data[this.top] := x
  end

  function Pop()
    if this.top < 0 then throw "stack underflow" end
    let v := this.data[this.top]
    this.top := this.top - 1
    return v
  end

  function Peek()
    if this.top < 0 then return null end
    return this.data[this.top]
  end

  function IsEmpty()
    return this.top < 0
  end
}

function isOperator(ch)
  return ch == "+" or ch == "-" or ch == "*" or ch == "/"
end

function isDigit(ch)
  return ch == "0" or ch == "1" or ch == "2" or ch == "3" or ch == "4" or
         ch == "5" or ch == "6" or ch == "7" or ch == "8" or ch == "9"
end

function charToDigit(ch)
  switch ch {
    case "0": return 0
    case "1": return 1
    case "2": return 2
    case "3": return 3
    case "4": return 4
    case "5": return 5
    case "6": return 6
    case "7": return 7
    case "8": return 8
    case "9": return 9
    default: return 0
  }
end

function Evaluate(tokens)
  let stk := new NumStack()
  foreach tok in tokens do
    if isDigit(tok) then
      stk.Push(charToDigit(tok))
    else
      if isOperator(tok) then
        let b := stk.Pop()
        let a := stk.Pop()
        if tok == "+" then stk.Push(a + b)
        else if tok == "-" then stk.Push(a - b)
        else if tok == "*" then stk.Push(a * b)
        else if tok == "/" then stk.Push(a / b) end
      end
    end
  end
  return stk.Pop()
end

let exprs := [
  ["2", "3", "+"],
  ["5", "1", "2", "+", "4", "*", "+", "3", "-"],
  ["3", "4", "*", "2", "+"],
  ["8", "4", "/", "2", "-"],
  ["7", "2", "3", "*", "+"],
  ["9", "3", "6", "+", "-"]
]

foreach expr in exprs do
  let result := Evaluate(expr)
  let display := ""
  foreach tok in expr do
    display := display & tok & " "
  end
  print display & "= " & str(result)
end
