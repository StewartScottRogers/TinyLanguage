function collatzSteps(n)
  let steps := 0
  while n != 1 do
    if n % 2 == 0 then
      n := n // 2
    else
      n := 3 * n + 1
    end
    steps := steps + 1
  end
  return steps
end
let maxSteps := 0
let maxN := 0
for i := 1 to 100 do
  let s := collatzSteps(i)
  if s > maxSteps then
    maxSteps := s
    maxN := i
  end
end
print "Max steps: " & str(maxSteps) & " for n=" & str(maxN)
