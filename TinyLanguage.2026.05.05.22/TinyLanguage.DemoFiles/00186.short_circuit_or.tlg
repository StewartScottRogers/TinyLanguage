let count := 0

function succeed()
  count := count + 1
  return true
end

# With ||, if left side is true the right side should not be called.
# succeed() returns true, so succeed() || succeed() short-circuits after first call.
if succeed() || succeed() then
  print "short-circuited"
else
  print "both called"
end
print "count: " & str(count)
