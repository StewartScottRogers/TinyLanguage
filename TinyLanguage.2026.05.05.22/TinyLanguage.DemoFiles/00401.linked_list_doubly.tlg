# Data structure: doubly linked list
# Subroutines: InsertBefore, InsertAfter, Remove, ForwardTraversal, ReverseTraversal, Size
# Workload: build list, insert before/after specific nodes, remove middle nodes, traverse both directions

class DNode {
  let val := 0
  let prev := null
  let next := null
  Constructor(v)
    this.val := v
  end
}

class DoublyLinkedList {
  let head := null
  let tail := null
  let size := 0

  function PushBack(v)
    let node := new DNode(v)
    if this.tail == null then
      this.head := node
      this.tail := node
    else
      node.prev := this.tail
      this.tail.next := node
      this.tail := node
    end
    this.size := this.size + 1
  end

  function InsertAfter(target, v)
    let cur := this.head
    while cur != null and cur.val != target do
      cur := cur.next
    end
    if cur == null then return end
    let node := new DNode(v)
    node.prev := cur
    node.next := cur.next
    if cur.next != null then
      cur.next.prev := node
    else
      this.tail := node
    end
    cur.next := node
    this.size := this.size + 1
  end

  function Remove(v)
    let cur := this.head
    while cur != null and cur.val != v do
      cur := cur.next
    end
    if cur == null then return end
    if cur.prev != null then
      cur.prev.next := cur.next
    else
      this.head := cur.next
    end
    if cur.next != null then
      cur.next.prev := cur.prev
    else
      this.tail := cur.prev
    end
    this.size := this.size - 1
  end

  function ForwardTraversal()
    let cur := this.head
    while cur != null do
      print cur.val
      cur := cur.next
    end
  end

  function ReverseTraversal()
    let cur := this.tail
    while cur != null do
      print cur.val
      cur := cur.prev
    end
  end

  function Size()
    return this.size
  end
}

let dll := new DoublyLinkedList()
dll.PushBack(1)
dll.PushBack(2)
dll.PushBack(3)
dll.PushBack(4)
dll.PushBack(5)
print "Size: " & str(dll.Size())
dll.InsertAfter(2, 99)
print "After inserting 99 after 2:"
dll.ForwardTraversal()
dll.Remove(99)
dll.Remove(3)
print "After removing 99 and 3:"
dll.ForwardTraversal()
print "Reverse:"
dll.ReverseTraversal()
