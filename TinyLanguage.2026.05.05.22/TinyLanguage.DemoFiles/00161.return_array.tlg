function minmax(arr)
  let minVal := arr[0]
  let maxVal := arr[0]
  foreach item in arr do
    if item < minVal then
      minVal := item
    end
    if item > maxVal then
      maxVal := item
    end
  end
  return [minVal, maxVal]
end
let data := [5, 2, 8, 1, 9, 3]
let result := minmax(data)
print result[0]
print result[1]
