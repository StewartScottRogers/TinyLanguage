class Serializable {
  function serialize()
    return "{}"
  end
}
class Printable {
  function printSelf()
    print "Printable"
  end
}
class Data implements Serializable {
  let key := "k"
  let val := "v"
  Constructor(k, v)
    this.key := k
    this.val := v
  end
  function serialize()
    return "{" & this.key & ": " & this.val & "}"
  end
}
let d := new Data("name", "Alice")
print d.serialize()
