# Data structure: sparse table for Range Minimum Query
# Subroutines: Build, Query, Log2Floor, RMQ
# Workload: build from 10-element array, 8 range minimum queries

function Log2Floor(n)
  let result := 0
  while 2 ** (result + 1) <= n do
    result := result + 1
  end
  return result
end

function BuildSparse(arr)
  let n := len(arr)
  let maxLog := Log2Floor(n) + 1
  let table := []
  for i := 0 to n - 1 do
    table[i] := []
    for j := 0 to maxLog do
      table[i][j] := 0
    end
    table[i][0] := arr[i]
  end
  for j := 1 to maxLog do
    let i := 0
    while i + 2 ** j - 1 < n do
      let left := table[i][j - 1]
      let right := table[i + 2 ** (j - 1)][j - 1]
      if left < right then
        table[i][j] := left
      else
        table[i][j] := right
      end
      i := i + 1
    end
  end
  return table
end

function RMQ(table, lo, hi)
  let length := hi - lo + 1
  let k := Log2Floor(length)
  let left := table[lo][k]
  let right := table[hi - 2 ** k + 1][k]
  if left < right then return left end
  return right
end

let arr := [1, 3, 2, 7, 9, 11, 3, 5, 6, 8]
let sparse := BuildSparse(arr)

print "RMQ(0,9): " & str(RMQ(sparse, 0, 9))
print "RMQ(0,0): " & str(RMQ(sparse, 0, 0))
print "RMQ(1,3): " & str(RMQ(sparse, 1, 3))
print "RMQ(4,7): " & str(RMQ(sparse, 4, 7))
print "RMQ(6,8): " & str(RMQ(sparse, 6, 8))
print "RMQ(0,5): " & str(RMQ(sparse, 0, 5))
print "RMQ(3,9): " & str(RMQ(sparse, 3, 9))
print "RMQ(5,6): " & str(RMQ(sparse, 5, 6))
