function merge(arr, lo, mid, hi)
  let left := []
  let right := []
  let li := 0
  let ri := 0
  for i := lo to mid do
    left[li] := arr[i]
    li := li + 1
  end
  for i := mid + 1 to hi do
    right[ri] := arr[i]
    ri := ri + 1
  end
  let lIdx := 0
  let rIdx := 0
  let k := lo
  while lIdx < li and rIdx < ri do
    if left[lIdx] <= right[rIdx] then
      arr[k] := left[lIdx]
      lIdx := lIdx + 1
    else
      arr[k] := right[rIdx]
      rIdx := rIdx + 1
    end
    k := k + 1
  end
  while lIdx < li do
    arr[k] := left[lIdx]
    lIdx := lIdx + 1
    k := k + 1
  end
  while rIdx < ri do
    arr[k] := right[rIdx]
    rIdx := rIdx + 1
    k := k + 1
  end
end
function mergeSort(arr, lo, hi)
  if lo >= hi then
    return
  end
  let mid := (lo + hi) // 2
  mergeSort(arr, lo, mid)
  mergeSort(arr, mid + 1, hi)
  merge(arr, lo, mid, hi)
end
let data := [38, 27, 43, 3, 9, 82, 10]
mergeSort(data, 0, 6)
foreach item in data do
  print item
end
