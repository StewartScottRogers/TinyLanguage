class Entity {
  let id := 0
  Constructor(i)
    this.id := i
  end
  function getType()
    return "entity"
  end
}
class Named extends Entity {
  let name := ""
  Constructor(i, n)
    this.id := i
    this.name := n
  end
  function getType()
    return "named"
  end
}
class Player extends Named {
  let score := 0
  Constructor(i, n)
    this.id := i
    this.name := n
  end
  function addScore(pts)
    this.score := this.score + pts
  end
  function getType()
    return "player"
  end
  function toString()
    return this.name & " (id=" & str(this.id) & ", score=" & str(this.score) & ")"
  end
}
let p := new Player(1, "Alice")
p.addScore(100)
p.addScore(50)
print p.toString()
print p.getType()
print p.id
