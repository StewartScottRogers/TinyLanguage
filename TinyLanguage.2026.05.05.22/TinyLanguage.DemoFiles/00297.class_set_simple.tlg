class SimpleSet {
  let data := []
  let size := 0
  function contains(x)
    for i := 0 to this.size - 1 do
      if this.data[i] == x then
        return true
      end
    end
    return false
  end
  function add(x)
    if not this.contains(x) then
      this.data[this.size] := x
      this.size := this.size + 1
    end
  end
  function getSize()
    return this.size
  end
}
let s := new SimpleSet()
s.add(1)
s.add(2)
s.add(1)
s.add(3)
s.add(2)
print s.getSize()
print s.contains(1)
print s.contains(5)
