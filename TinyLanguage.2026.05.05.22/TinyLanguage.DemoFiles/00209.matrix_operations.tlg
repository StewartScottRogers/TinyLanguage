function matMul(a, b, size)
  let result := []
  for i := 0 to size - 1 do
    result[i] := []
    for j := 0 to size - 1 do
      result[i][j] := 0
      for k := 0 to size - 1 do
        result[i][j] := result[i][j] + a[i][k] * b[k][j]
      end
    end
  end
  return result
end
let a := [[1, 2], [3, 4]]
let b := [[5, 6], [7, 8]]
let c := matMul(a, b, 2)
print c[0][0]
print c[0][1]
print c[1][0]
print c[1][1]
