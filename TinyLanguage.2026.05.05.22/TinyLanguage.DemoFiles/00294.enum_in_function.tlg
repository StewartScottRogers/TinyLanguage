enum Status {
  Active = 1,
  Inactive = 0,
  Pending = 2
}
function statusName(s)
  switch s {
    case 0: return "inactive"
    case 1: return "active"
    case 2: return "pending"
    default: return "unknown"
  }
end
print statusName(Status.Active)
print statusName(Status.Inactive)
print statusName(Status.Pending)
