class Pool {
  let items := []
  let capacity := 0
  let size := 0
  Constructor(cap)
    this.capacity := cap
    for i := 0 to cap - 1 do
      this.items[i] := null
    end
  end
  function add(x)
    if this.size >= this.capacity then
      throw "pool full"
    end
    this.items[this.size] := x
    this.size := this.size + 1
  end
  function get(i)
    return this.items[i]
  end
  function getSize()
    return this.size
  end
}
let p := new Pool(5)
p.add("alpha")
p.add("beta")
p.add("gamma")
print p.get(0)
print p.get(2)
print p.getSize()
