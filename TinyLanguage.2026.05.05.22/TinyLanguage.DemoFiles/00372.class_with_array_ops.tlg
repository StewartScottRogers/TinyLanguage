class NumberList {
  let data := []
  let size := 0
  function push(x)
    this.data[this.size] := x
    this.size := this.size + 1
  end
  function sum()
    let total := 0
    for i := 0 to this.size - 1 do
      total := total + this.data[i]
    end
    return total
  end
  function product()
    let total := 1
    for i := 0 to this.size - 1 do
      total := total * this.data[i]
    end
    return total
  end
  function contains(x)
    for i := 0 to this.size - 1 do
      if this.data[i] == x then return true end
    end
    return false
  end
}
let nl := new NumberList()
nl.push(2)
nl.push(3)
nl.push(5)
nl.push(7)
print nl.sum()
print nl.product()
print nl.contains(5)
print nl.contains(4)
