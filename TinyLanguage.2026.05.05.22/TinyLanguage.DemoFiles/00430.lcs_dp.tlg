# Data structure: 2D DP table for Longest Common Subsequence
# Subroutines: LCS, BacktrackLCS, LCSLength, BuildTable
# Workload: compute LCS for 4 pairs of strings, print length and one LCS each time

function BuildTable(s1, s2)
  let m := len(s1)
  let n := len(s2)
  let dp := []
  for i := 0 to m do
    dp[i] := []
    for j := 0 to n do
      dp[i][j] := 0
    end
  end
  for i := 1 to m do
    for j := 1 to n do
      if s1[i - 1] == s2[j - 1] then
        dp[i][j] := dp[i - 1][j - 1] + 1
      else
        if dp[i - 1][j] >= dp[i][j - 1] then
          dp[i][j] := dp[i - 1][j]
        else
          dp[i][j] := dp[i][j - 1]
        end
      end
    end
  end
  return dp
end

function LCSLength(s1, s2)
  let dp := BuildTable(s1, s2)
  return dp[len(s1)][len(s2)]
end

function BacktrackLCS(s1, s2)
  let dp := BuildTable(s1, s2)
  let m := len(s1)
  let n := len(s2)
  let result := ""
  while m > 0 and n > 0 do
    if s1[m - 1] == s2[n - 1] then
      result := s1[m - 1] & result
      m := m - 1
      n := n - 1
    else
      if dp[m - 1][n] >= dp[m][n - 1] then
        m := m - 1
      else
        n := n - 1
      end
    end
  end
  return result
end

let pairs := [
  ["ABCBDAB", "BDCAB"],
  ["AGGTAB", "GXTXAYB"],
  ["abc", "abc"],
  ["abcdef", "acf"]
]

foreach pair in pairs do
  let s1 := pair[0]
  let s2 := pair[1]
  let length := LCSLength(s1, s2)
  let lcs := BacktrackLCS(s1, s2)
  print "LCS('" & s1 & "', '" & s2 & "') = " & str(length) & " [" & lcs & "]"
end
