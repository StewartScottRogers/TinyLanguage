function httpMethod(method)
  match method {
    "GET" => return "retrieve"
    "POST" => return "create"
    "PUT" => return "update"
    "DELETE" => return "delete"
    _ => return "unknown"
  }
end
let methods := ["GET", "POST", "PUT", "DELETE", "PATCH"]
foreach m in methods do
  print m & " -> " & httpMethod(m)
end
