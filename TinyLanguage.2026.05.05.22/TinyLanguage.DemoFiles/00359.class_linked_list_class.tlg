class LNode {
  let val := 0
  let next := null
  Constructor(v)
    this.val := v
  end
}
class LinkedList {
  let head := null
  let size := 0
  function append(v)
    let node := new LNode(v)
    if this.head == null then
      this.head := node
    else
      let cur := this.head
      while cur.next != null do
        cur := cur.next
      end
      cur.next := node
    end
    this.size := this.size + 1
  end
  function printAll()
    let cur := this.head
    while cur != null do
      print cur.val
      cur := cur.next
    end
  end
  function length()
    return this.size
  end
}
let list := new LinkedList()
list.append(1)
list.append(2)
list.append(3)
list.append(4)
list.append(5)
print list.length()
list.printAll()
