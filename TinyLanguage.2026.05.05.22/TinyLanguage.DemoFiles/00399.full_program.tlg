# Complete program exercising all major features

enum Season { Spring = 1, Summer = 2, Autumn = 3, Winter = 4 }

class Weather {
  let season := 0
  let temp := 0.0
  Constructor(s, t)
    this.season := s
    this.temp := t
  end
  function describe()
    let seasonName := ""
    switch this.season {
      case 1: seasonName := "Spring"
      case 2: seasonName := "Summer"
      case 3: seasonName := "Autumn"
      case 4: seasonName := "Winter"
      default: seasonName := "Unknown"
    }
    let feel := if this.temp > 25.0 then "hot" else if this.temp > 15.0 then "warm" else "cold"
    return seasonName & " is " & feel & " (" & str(this.temp) & "C)"
  end
}

function analyzeWeather(records)
  let total := 0.0
  let count := 0
  foreach w in records do
    total := total + w.temp
    count := count + 1
    print w.describe()
  end
  return total / (float) count
end

let weatherData := [
  new Weather(Season.Spring, 18.5),
  new Weather(Season.Summer, 30.2),
  new Weather(Season.Autumn, 12.0),
  new Weather(Season.Winter, -2.5)
]

let avg := analyzeWeather(weatherData)
print "Average: " & str(avg) & "C"
