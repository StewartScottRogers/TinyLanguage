# Data structure: segment tree for range sum queries and point updates
# Subroutines: Build, Update, Query, RangeSum
# Workload: build from 8-element array, 4 range queries, 3 point updates, re-query

class SegmentTree {
  let tree := []
  let n := 0

  Constructor(arr)
    this.n := len(arr)
    for i := 0 to 4 * this.n do
      this.tree[i] := 0
    end
    this.build(arr, 0, 0, this.n - 1)
  end

  function build(arr, node, start, end)
    if start == end then
      this.tree[node] := arr[start]
      return
    end
    let mid := (start + end) // 2
    this.build(arr, 2 * node + 1, start, mid)
    this.build(arr, 2 * node + 2, mid + 1, end)
    this.tree[node] := this.tree[2 * node + 1] + this.tree[2 * node + 2]
  end

  function Update(idx, val)
    this.update(0, 0, this.n - 1, idx, val)
  end

  function update(node, start, end, idx, val)
    if start == end then
      this.tree[node] := val
      return
    end
    let mid := (start + end) // 2
    if idx <= mid then
      this.update(2 * node + 1, start, mid, idx, val)
    else
      this.update(2 * node + 2, mid + 1, end, idx, val)
    end
    this.tree[node] := this.tree[2 * node + 1] + this.tree[2 * node + 2]
  end

  function RangeSum(lo, hi)
    return this.query(0, 0, this.n - 1, lo, hi)
  end

  function query(node, start, end, lo, hi)
    if hi < start or end < lo then return 0 end
    if lo <= start and end <= hi then return this.tree[node] end
    let mid := (start + end) // 2
    return this.query(2 * node + 1, start, mid, lo, hi) +
           this.query(2 * node + 2, mid + 1, end, lo, hi)
  end
}

let arr := [1, 3, 5, 7, 9, 11, 13, 15]
let st := new SegmentTree(arr)

print "RangeSum(0,7): " & str(st.RangeSum(0, 7))
print "RangeSum(0,3): " & str(st.RangeSum(0, 3))
print "RangeSum(4,7): " & str(st.RangeSum(4, 7))
print "RangeSum(2,5): " & str(st.RangeSum(2, 5))

st.Update(3, 10)
st.Update(5, 2)
st.Update(7, 20)
print "After updates:"
print "RangeSum(0,7): " & str(st.RangeSum(0, 7))
print "RangeSum(2,5): " & str(st.RangeSum(2, 5))
