function toUpperChar(c)
  let code := 0
  if c == "a" then code := 65 end
  if c == "b" then code := 66 end
  if c == "c" then code := 67 end
  if c == "d" then code := 68 end
  if c == "e" then code := 69 end
  if c == "f" then code := 70 end
  if c == "g" then code := 71 end
  if c == "h" then code := 72 end
  if c == "i" then code := 73 end
  if code == 0 then return c end
  switch code {
    case 65: return "A"
    case 66: return "B"
    case 67: return "C"
    case 68: return "D"
    case 69: return "E"
    case 70: return "F"
    case 71: return "G"
    case 72: return "H"
    case 73: return "I"
    default: return c
  }
end
let s := "hello"
let result := ""
foreach ch in s do
  result := result & toUpperChar(ch)
end
print result
